---
import "@fontsource-variable/geist";
import CrmAppMetadata from "../components/ui/CrmAppMetadata.astro";
import { Image } from "astro:assets";
import portrait from "../assets/images/orpira-hero-professional.png";
import "../styles/global.css";
import "../styles/crm-responsive.css";

interface Props {
  title?: string;
}

const { title = "CRM OrPiRa" } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "");
const navigation = [
  { href: "/dashboard/resumen", label: "Dashboard" },
  { href: "/dashboard/embudo", label: "Embudo" },
  { href: "/dashboard/leads", label: "Leads" },
  { href: "/dashboard/seguimientos", label: "Seguimientos" },
  { href: "/dashboard/clientes", label: "Clientes" },
  { href: "/dashboard/reportes", label: "Reportes" },
  { href: "/dashboard/configuracion", label: "Configuración" },
];
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <CrmAppMetadata />
  </head>
  <body class="crm-shell">
    <a href="#contenido-crm" class="sr-only focus:not-sr-only">Saltar al contenido</a>
    <aside class="crm-sidebar">
      <div class="crm-sidebar-header">
        <a href="/dashboard/resumen" class="crm-brand">
          <img src="/brand/wordmark-crm.webp" width="560" height="198" alt="OrPiRa" decoding="async" />
          <small>CRM</small>
        </a>
        <button type="button" id="crm-menu-toggle" aria-expanded="true" aria-controls="crm-menu" hidden>Menú</button>
      </div>
      <div id="crm-menu" class="crm-menu">
        <nav aria-label="Navegación del CRM">
          {navigation.map(({ href, label }) => {
            const active = path === href || (label === "Leads" && path.startsWith("/dashboard/lead/"));
            return <a href={href} aria-current={active ? "page" : undefined}>{label}</a>;
          })}
        </nav>
        <form method="post" action="/dashboard/logout">
          <div class="crm-profile">
            <Image src={portrait} alt="" width={96} format="webp" quality={78} />
            <span>Orlando Pineda</span>
          </div>
          <button type="submit">Cerrar sesión</button>
        </form>
      </div>
    </aside>
    <main id="contenido-crm" class="crm-main"><slot /></main>
  </body>
</html>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("#crm-menu-toggle");
  if (toggle) {
    toggle.setAttribute("aria-expanded", "false");
    toggle.hidden = false;
    toggle.addEventListener("click", () => {
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!expanded));
    });
  }
</script>

<style>
  .crm-shell {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    min-height: 100vh;
    color: #f1f5f9;
    background: #f1f5f9;
    font-family: "Geist Variable", sans-serif;
  }
  .crm-shell::before { display: none; }
  .crm-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
    padding: 1.5rem 1rem;
    background: #101829;
  }
  .crm-sidebar-header { display: flex; align-items: center; justify-content: space-between; gap: .5rem; }
  .crm-menu { display: flex; flex: 1; flex-direction: column; gap: .75rem; }
  #crm-menu-toggle { display: none; }
  .crm-brand { display: flex; align-items: center; gap: .75rem; padding: 0 .5rem; }
  .crm-brand img { display: block; width: min(70%, 9rem); height: auto; }
  .crm-profile {
    display: flex;
    align-items: center;
    gap: .6rem;
    padding: .75rem .6rem .45rem;
    border-top: 1px solid #293950;
    font-size: .85rem;
    font-weight: 600;
  }
  .crm-profile img {
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 28%;
  }
  .crm-brand small { color: #a7bacf; font-weight: 600; }
  nav { display: flex; flex-direction: column; gap: .4rem; }
  nav a, form button { padding: .65rem .8rem; border-radius: .5rem; color: #cbd5e1; }
  nav a:hover, form button:hover { background: #243349; color: white; }
  nav a[aria-current] { background: #20354a; color: #a7f3d0; font-weight: 650; }
  form { margin-top: auto; }
  .crm-main { padding: clamp(.9rem, 3vw, 2.75rem); min-width: 0; }
  @media (max-width: 900px) {
    .crm-shell { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto 1fr; }
    .crm-sidebar { position: static; height: auto; gap: .65rem; padding: .65rem .9rem; }
    .crm-brand img { width: 6.25rem; }
    #crm-menu-toggle:not([hidden]) {
      display: block;
      min-height: 44px;
      padding: .45rem .85rem;
      border: 1px solid #516377;
      border-radius: .5rem;
    }
    .crm-sidebar:has(#crm-menu-toggle[aria-expanded="false"]) .crm-menu { display: none; }
    nav { display: grid; grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr)); }
    form { display: flex; align-items: center; justify-content: space-between; gap: .4rem; border-top: 1px solid #293950; }
    .crm-profile { border: 0; padding: .45rem .55rem; }
    nav a, form button { min-height: 44px; padding: .65rem .55rem; }
  }
</style>
