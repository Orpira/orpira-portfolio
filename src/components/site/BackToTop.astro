---
/**
 * Botón flotante para volver arriba.
 * Aparece tras desplazarse más de una pantalla y respeta prefers-reduced-motion.
 */
---

<button
	type="button"
	id="back-to-top"
	aria-label="Volver arriba"
	title="Volver arriba"
	tabindex="-1"
	class="fixed bottom-5 right-5 z-40 grid size-12 translate-y-4 place-items-center rounded-full bg-ink text-paper opacity-0 shadow-lg shadow-ink/20 transition-[opacity,transform,background-color] duration-300 pointer-events-none hover:bg-accent hover:text-accent-on focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent motion-reduce:transition-none data-[visible=true]:pointer-events-auto data-[visible=true]:translate-y-0 data-[visible=true]:opacity-100 sm:bottom-8 sm:right-8"
>
	<svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
		<path d="M12 19V5M5 12l7-7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
	</svg>
</button>

<script>
	const btn = document.getElementById("back-to-top");
	if (btn) {
		let ticking = false;
		const update = () => {
			const visible = window.scrollY > window.innerHeight * 0.8;
			btn.dataset.visible = String(visible);
			btn.tabIndex = visible ? 0 : -1;
			ticking = false;
		};
		window.addEventListener(
			"scroll",
			() => {
				if (!ticking) {
					ticking = true;
					requestAnimationFrame(update);
				}
			},
			{ passive: true },
		);
		update();
		btn.addEventListener("click", () => {
			const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
			document.getElementById("contenido")?.focus({ preventScroll: true });
		});
	}
</script>
