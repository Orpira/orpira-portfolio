---
import Button from "../ui/Button.astro";

interface Props {
	/** true en la portada: los enlaces son anclas locales (#casos). */
	isHome?: boolean;
}

const { isHome = false } = Astro.props;
const link = (hash: string) => (isHome ? hash : `/${hash}`);

const nav = [
	{ label: "Casos", hash: "#casos" },
	{ label: "Servicios", hash: "#servicios" },
	{ label: "Cómo trabajo", hash: "#proceso" },
	{ label: "Sobre mí", hash: "#sobre-mi" },
];
---

<header
	class="site-header sticky top-0 z-50 border-b border-transparent bg-paper/85 backdrop-blur-md transition-[border-color] duration-300"
	data-site-header
>
	<a
		href="#contenido"
		class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-3 focus:z-[60] focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
	>
		Saltar al contenido
	</a>

	<div class="container-site flex h-[var(--header-h)] items-center justify-between gap-6">
		<a href={link("#inicio")} class="flex items-center gap-2.5">
			<img
				src="/brand/opr-cubo-192.webp"
				alt=""
				width="32"
				height="32"
				class="size-8"
				decoding="async"
			/>
			<span class="font-heading text-[1.6rem] italic leading-none text-ink">OrPiRa</span>
			<span class="sr-only">, ir al inicio</span>
		</a>

		<nav aria-label="Principal" class="hidden lg:block">
			<ul class="flex items-center gap-8 text-[0.9375rem]">
				{
					nav.map((item) => (
						<li>
							<a href={link(item.hash)} class="link-underline text-ink-soft hover:text-ink">
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="flex items-center gap-2">
			<button
				type="button"
				class="grid size-10 place-items-center rounded-full text-ink-soft hover:bg-ink/5 hover:text-ink"
				data-theme-toggle
				aria-label="Activar modo oscuro"
			>
				<svg class="size-[1.15rem] dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
				</svg>
				<svg class="hidden size-[1.15rem] dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
					<circle cx="12" cy="12" r="4" />
					<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
				</svg>
			</button>

			<Button href={link("#contacto")} class="hidden sm:inline-flex">Hablemos</Button>

			<button
				type="button"
				class="grid size-10 place-items-center rounded-full text-ink hover:bg-ink/5 lg:hidden"
				aria-expanded="false"
				aria-controls="menu-movil"
				aria-label="Abrir menú"
				data-menu-toggle
			>
				<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
					<path class="menu-line-a" d="M4 8h16" />
					<path class="menu-line-b" d="M4 16h16" />
				</svg>
			</button>
		</div>
	</div>

	<div id="menu-movil" class="hidden border-t border-line bg-paper lg:hidden" data-menu-panel>
		<nav aria-label="Principal (móvil)" class="container-site py-6">
			<ul class="space-y-1">
				{
					nav.map((item) => (
						<li>
							<a href={link(item.hash)} class="block py-2.5 font-heading text-3xl text-ink" data-menu-link>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
			<Button href={link("#contacto")} size="lg" class="mt-6 w-full" data-menu-link>
				Hablemos
			</Button>
		</nav>
	</div>
</header>

<style>
	.site-header[data-scrolled] {
		border-bottom-color: rgb(var(--line));
	}

	[aria-expanded="true"] .menu-line-a {
		transform: translateY(4px) rotate(45deg);
	}

	[aria-expanded="true"] .menu-line-b {
		transform: translateY(-4px) rotate(-45deg);
	}

	.menu-line-a,
	.menu-line-b {
		transform-origin: center;
		transform-box: fill-box;
		transition: transform 0.25s var(--ease-out);
	}
</style>

<script>
	const header = document.querySelector<HTMLElement>("[data-site-header]");
	const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
	const panel = document.querySelector<HTMLElement>("[data-menu-panel]");
	const themeToggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");

	// Línea inferior de la cabecera solo cuando hay scroll.
	if (header) {
		const sentinel = document.createElement("div");
		sentinel.setAttribute("aria-hidden", "true");
		sentinel.style.cssText = "position:absolute;top:0;height:1px;width:1px;";
		document.body.prepend(sentinel);
		new IntersectionObserver(([entry]) => {
			header.toggleAttribute("data-scrolled", !entry.isIntersecting);
		}).observe(sentinel);
	}

	// Menú móvil accesible.
	const setMenu = (open: boolean) => {
		if (!toggle || !panel) return;
		toggle.setAttribute("aria-expanded", String(open));
		toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
		panel.classList.toggle("hidden", !open);
	};

	toggle?.addEventListener("click", () => {
		setMenu(toggle.getAttribute("aria-expanded") !== "true");
	});
	panel?.querySelectorAll("[data-menu-link]").forEach((el) =>
		el.addEventListener("click", () => setMenu(false)),
	);
	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
			setMenu(false);
			toggle.focus();
		}
	});
	window.matchMedia("(min-width: 1024px)").addEventListener("change", (mq) => {
		if (mq.matches) setMenu(false);
	});

	// Tema: el estado inicial lo pone el script inline del <head>.
	const syncThemeLabel = () => {
		const dark = document.documentElement.classList.contains("dark");
		themeToggle?.setAttribute("aria-label", dark ? "Activar modo claro" : "Activar modo oscuro");
	};
	syncThemeLabel();
	themeToggle?.addEventListener("click", () => {
		const dark = document.documentElement.classList.toggle("dark");
		try {
			localStorage.setItem("theme", dark ? "dark" : "light");
		} catch {
			/* modo privado: el tema no se recuerda, pero funciona */
		}
		syncThemeLabel();
	});
</script>
