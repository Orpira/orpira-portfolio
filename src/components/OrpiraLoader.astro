<div
	id="orpira-loader"
	class="orpira-loader"
	role="status"
	aria-label="Cargando portfolio de OrPiRa"
>
	<div class="orpira-loader__scene" aria-hidden="true">
		<div class="orpira-loader__shadow"></div>
		<div class="orpira-loader__cube">
			<div class="orpira-loader__face orpira-loader__face--front">
				<div class="orpira-loader__panel"><span class="orpira-loader__mark orpira-loader__mark--pi">π</span></div>
			</div>
			<div class="orpira-loader__face orpira-loader__face--right">
				<div class="orpira-loader__panel"><span class="orpira-loader__mark">Ra</span></div>
			</div>
			<div class="orpira-loader__face orpira-loader__face--top">
				<div class="orpira-loader__panel"><span class="orpira-loader__mark">Or</span></div>
			</div>
			<div class="orpira-loader__face orpira-loader__face--left">
				<div class="orpira-loader__panel"><span class="orpira-loader__mark">Or</span></div>
			</div>
			<div class="orpira-loader__face orpira-loader__face--back">
				<div class="orpira-loader__panel">
					<div class="orpira-loader__lan-wrap">
						<svg class="orpira-loader__lan" viewBox="0 0 220 220" role="img" aria-label="LAN">
							<defs>
								<linearGradient id="orpira-loader-metal-lan" x1="0" y1="0" x2="1" y2="1">
									<stop offset="0" stop-color="#fff" />
									<stop offset=".2" stop-color="#d3d3d7" />
									<stop offset=".44" stop-color="#777980" />
									<stop offset=".63" stop-color="#f5f5f6" />
									<stop offset=".82" stop-color="#8f9096" />
									<stop offset="1" stop-color="#ececef" />
								</linearGradient>
							</defs>
							<path d="M110 52 L57 150 M110 52 L163 150 M57 150 L163 150" fill="none" stroke="url(#orpira-loader-metal-lan)" stroke-width="15" stroke-linecap="round" stroke-linejoin="round" />
							<rect x="87" y="29" width="46" height="46" rx="11" fill="url(#orpira-loader-metal-lan)" stroke="#fff" stroke-width="2" />
							<rect x="34" y="127" width="46" height="46" rx="11" fill="url(#orpira-loader-metal-lan)" stroke="#fff" stroke-width="2" />
							<rect x="140" y="127" width="46" height="46" rx="11" fill="url(#orpira-loader-metal-lan)" stroke="#fff" stroke-width="2" />
							<circle cx="110" cy="117" r="12" fill="#b5b6bb" stroke="#f7f7f8" stroke-width="2" />
						</svg>
					</div>
				</div>
			</div>
			<div class="orpira-loader__face orpira-loader__face--bottom">
				<div class="orpira-loader__panel"><span class="orpira-loader__mark">Do</span></div>
			</div>
		</div>
	</div>
	<div class="orpira-loader__wordmark">OrPiRa</div>
	<div class="orpira-loader__tagline">Tecnología con visión de negocio</div>
	<button class="orpira-loader__skip" type="button">Entrar</button>
</div>

<style>
	.orpira-loader {
		--loader-size: min(48vw, 270px);
		--loader-half: calc(var(--loader-size) / 2);
		position: fixed;
		inset: 0;
		z-index: 100;
		display: grid;
		place-items: center;
		align-content: center;
		gap: 1rem;
		overflow: hidden;
		background:
			radial-gradient(circle at 50% 36%, #191a20 0%, #0b0c10 38%, #030304 78%, #000 100%);
		color: #fff;
		font-family: "Cormorant Garamond", Georgia, serif;
		opacity: 1;
		transition: opacity 0.55s ease, visibility 0.55s ease;
	}

	.orpira-loader.is-exiting {
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
	}

	.orpira-loader.is-exiting .orpira-loader__scene {
		transform: scale(0.88);
		opacity: 0.65;
	}

	.orpira-loader__scene {
		position: relative;
		width: min(92vw, 720px);
		height: min(58vh, 430px);
		display: grid;
		place-items: center;
		perspective: 1500px;
		perspective-origin: 50% 44%;
		transition: transform 0.55s ease, opacity 0.55s ease;
	}

	.orpira-loader__shadow {
		position: absolute;
		width: calc(var(--loader-size) * 1.65);
		height: calc(var(--loader-size) * 0.42);
		left: 50%;
		top: 69%;
		transform: translate(-50%, -50%);
		background: radial-gradient(ellipse, rgba(0, 0, 0, 0.95) 0%, rgba(0, 0, 0, 0.58) 38%, transparent 72%);
		filter: blur(11px);
	}

	.orpira-loader__cube {
		position: relative;
		width: var(--loader-size);
		height: var(--loader-size);
		transform-style: preserve-3d;
		animation: orpira-loader-motion 4s linear infinite;
		will-change: transform;
	}

	.orpira-loader__face {
		position: absolute;
		inset: 0;
		transform-style: preserve-3d;
		backface-visibility: hidden;
		border-radius: 24px;
		padding: 10px;
		background: linear-gradient(145deg, #e9e9ed 0%, #85878d 9%, #f5f5f7 17%, #77797f 28%, #d8d8dc 44%, #5d5f65 57%, #f3f3f5 72%, #797b81 86%, #e8e8eb 100%);
		box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.8), inset 0 0 0 1px rgba(0, 0, 0, 0.55), 0 18px 35px rgba(0, 0, 0, 0.35);
	}

	.orpira-loader__face::before {
		content: "";
		position: absolute;
		inset: 6px;
		border-radius: 20px;
		background: linear-gradient(135deg, rgba(255, 255, 255, 0.78), rgba(255, 255, 255, 0.06) 18%, rgba(0, 0, 0, 0.42) 48%, rgba(255, 255, 255, 0.46) 82%, rgba(255, 255, 255, 0.7));
		pointer-events: none;
	}

	.orpira-loader__panel {
		position: absolute;
		inset: 16px;
		display: grid;
		place-items: center;
		border-radius: 17px;
		background: radial-gradient(circle at 36% 28%, rgba(255, 255, 255, 0.055), transparent 22%), linear-gradient(145deg, #151518 0%, #08080a 56%, #020203 100%);
		box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.11), inset 0 0 28px rgba(0, 0, 0, 0.88), 0 0 0 2px rgba(20, 20, 22, 0.92);
	}

	.orpira-loader__panel::after {
		content: "";
		position: absolute;
		inset: 7px;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 12px;
	}

	.orpira-loader__face--front { transform: translateZ(var(--loader-half)); }
	.orpira-loader__face--back { transform: rotateY(180deg) translateZ(var(--loader-half)); }
	.orpira-loader__face--right { transform: rotateY(90deg) translateZ(var(--loader-half)); }
	.orpira-loader__face--left { transform: rotateY(-90deg) translateZ(var(--loader-half)); }
	.orpira-loader__face--top { transform: rotateX(90deg) translateZ(var(--loader-half)); }
	.orpira-loader__face--bottom { transform: rotateX(-90deg) translateZ(var(--loader-half)); }

	.orpira-loader__mark {
		position: relative;
		z-index: 2;
		font-size: clamp(72px, calc(var(--loader-size) * 0.34), 116px);
		line-height: 1;
		font-style: italic;
		font-weight: 500;
		letter-spacing: -0.055em;
		transform: translateZ(20px);
		background: linear-gradient(115deg, #fff 0%, #d6d6d9 14%, #8f9095 28%, #f5f5f6 45%, #a1a2a7 60%, #fcfcfd 75%, #7f8086 90%, #dedee2 100%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		-webkit-text-stroke: 1px rgba(255, 255, 255, 0.55);
		text-shadow: 0 1px 0 rgba(255, 255, 255, 0.75), 1px 2px 0 rgba(95, 96, 102, 0.7), 2px 4px 1px rgba(25, 25, 28, 0.85), 5px 8px 9px rgba(0, 0, 0, 0.85);
	}

	.orpira-loader__mark--pi { font-size: clamp(106px, calc(var(--loader-size) * 0.44), 148px); letter-spacing: 0; }
	.orpira-loader__lan-wrap {
		position: relative;
		z-index: 2;
		width: 74%;
		height: 74%;
		display: grid;
		place-items: center;
		transform: translateZ(22px);
		filter: drop-shadow(4px 8px 7px rgba(0, 0, 0, 0.82));
	}
	.orpira-loader__lan { width: 100%; height: 100%; overflow: visible; }
	.orpira-loader__wordmark { font-size: clamp(2.2rem, 7vw, 3.5rem); line-height: 0.9; font-style: italic; font-weight: 600; letter-spacing: -0.045em; }
	.orpira-loader__tagline { color: #85868d; font-family: "Manrope", sans-serif; font-size: 0.68rem; letter-spacing: 0.18em; text-align: center; text-transform: uppercase; }
	.orpira-loader__skip { margin-top: 0.45rem; border: 1px solid rgba(255, 255, 255, 0.24); border-radius: 999px; padding: 0.55rem 1rem; color: #d7d7da; background: transparent; font: 600 0.65rem/1 "Manrope", sans-serif; letter-spacing: 0.18em; text-transform: uppercase; cursor: pointer; }
	.orpira-loader__skip:hover, .orpira-loader__skip:focus-visible { border-color: rgba(255, 255, 255, 0.7); color: #fff; }

	@keyframes orpira-loader-motion {
		0% { transform: rotateX(-18deg) rotateY(32deg); }
		25% { transform: rotateX(-8deg) rotateY(122deg); }
		50% { transform: rotateX(18deg) rotateY(212deg); }
		75% { transform: rotateX(-6deg) rotateY(302deg); }
		100% { transform: rotateX(-18deg) rotateY(392deg); }
	}

	@media (max-width: 480px) {
		.orpira-loader__scene { height: min(55vh, 370px); }
		.orpira-loader__tagline { max-width: 19rem; line-height: 1.5; }
	}

	@media (prefers-reduced-motion: reduce) {
		.orpira-loader__cube { animation: none; }
	}
</style>

<script is:inline>
	const loader = document.getElementById("orpira-loader");
	const loaderSessionKey = "orpira_loader_seen_v1";

	if (loader) {
		let alreadySeen = false;
		try {
			alreadySeen = sessionStorage.getItem(loaderSessionKey) === "1";
		} catch (error) {
			console.warn("No se pudo consultar la sesion del loader", error);
		}

		const removeLoader = () => {
			if (!loader || loader.classList.contains("is-exiting")) return;
			try {
				sessionStorage.setItem(loaderSessionKey, "1");
			} catch (error) {
				console.warn("No se pudo guardar la sesion del loader", error);
			}
			loader.classList.add("is-exiting");
			window.setTimeout(() => loader.remove(), 500);
		};

		if (alreadySeen) {
			loader.remove();
		} else {
			const ready = document.fonts?.ready ?? Promise.resolve();
			const minimumDisplay = new Promise((resolve) => window.setTimeout(resolve, 850));
			const pageReady = new Promise((resolve) => {
				if (document.readyState === "complete") resolve();
				else window.addEventListener("load", resolve, { once: true });
			});

			Promise.all([ready, minimumDisplay, pageReady]).then(removeLoader);
			loader.querySelector(".orpira-loader__skip")?.addEventListener("click", removeLoader);
		}
	}
</script>