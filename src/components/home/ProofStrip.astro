---
/**
 * Franja de cifras bajo el hero: una sola línea fina dentro de los márgenes
 * del contenido (alineada con las persianas), y debajo una fila compacta:
 * cifra, áreas y cifra, separadas por cubos OrPiRa girando.
 */
import MiniCube from "../MiniCube.astro";
import { stats, publishable } from "../../data/home";

const items = publishable(stats).filter((s) => s.value !== null);
const [first, ...rest] = items;
const areas = ["Apps web", "Tiempo real", "IA aplicada"];
---

{
	first && (
		<section aria-label="Algunas cifras">
			<div class="container-site">
				<div class="proof">
					<dl class="proof-item">
						<dt class="sr-only">{first.label}</dt>
						<dd>
							<span class="proof-num">{first.value}</span>
							<span class="proof-label" aria-hidden="true">{first.label}</span>
						</dd>
					</dl>

					{areas.map((a, i) => (
						<>
							<MiniCube size={20} delay={i * 1.6} class:list={["proof-cube", i === 0 && "proof-cube--edge"]} />
							<p class="proof-area">{a}</p>
						</>
					))}

					{rest.map((stat, i) => (
						<>
							<MiniCube size={20} delay={(areas.length + i) * 1.6} class="proof-cube proof-cube--edge" />
							<dl class="proof-item">
								<dt class="sr-only">{stat.label}</dt>
								<dd>
									<span class="proof-num">{stat.value}</span>
									<span class="proof-label" aria-hidden="true">{stat.label}</span>
								</dd>
							</dl>
						</>
					))}
				</div>
			</div>
		</section>
	)
}

<style>
	.proof {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.9rem 0.65rem;
		border-top: 1px solid rgb(var(--line));
		padding: 1.25rem 0 0.5rem;
	}
	.proof-item {
		margin: 0;
	}
	.proof-item dd {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin: 0;
	}
	.proof-num {
		font-family: var(--font-heading);
		font-size: 2rem;
		line-height: 1;
		color: rgb(var(--accent-ink));
	}
	.proof-label,
	.proof-area {
		margin: 0;
		font-family: var(--font-data);
		font-size: 0.75rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: rgb(var(--ink-soft));
	}

	@media (min-width: 640px) {
		.proof {
			column-gap: 1.25rem;
		}
	}

	/* Pantallas estrechas: cada cifra en su línea; los cubos solo separan las áreas. */
	@media (max-width: 1279px) {
		.proof-item {
			flex-basis: 100%;
		}
		.proof :global(.proof-cube--edge) {
			display: none;
		}
	}

	@media (min-width: 1280px) {
		.proof {
			flex-wrap: nowrap;
			justify-content: space-between;
			column-gap: 1rem;
		}
		.proof-label,
		.proof-area {
			white-space: nowrap;
		}
	}
</style>
