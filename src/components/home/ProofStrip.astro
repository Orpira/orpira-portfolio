---
/**
 * Franja de cifras bajo el hero: una sola línea fina dentro de los márgenes
 * del contenido (alineada con las persianas), y debajo una fila compacta:
 * cifra a la izquierda, áreas en el centro y cifra a la derecha.
 */
import { stats, publishable } from "../../data/home";

const items = publishable(stats).filter((s) => s.value !== null);
const [first, ...rest] = items;
const areas = ["Apps web", "Tiempo real", "IA aplicada"];
---

{
	first && (
		<section aria-label="Algunas cifras">
			<div class="container-site">
				<dl class="proof">
					<div class="proof-item">
						<dt class="sr-only">{first.label}</dt>
						<dd>
							<span class="proof-num">{first.value}</span>
							<span class="proof-label" aria-hidden="true">{first.label}</span>
						</dd>
					</div>

					<p class="proof-areas t-data" aria-label="Áreas">
						{areas.map((a, i) => (
							<>
								{i > 0 && <span aria-hidden="true" class="text-accent-ink"> · </span>}
								{a}
							</>
						))}
					</p>

					{rest.map((stat) => (
						<div class="proof-item proof-item--end">
							<dt class="sr-only">{stat.label}</dt>
							<dd>
								<span class="proof-num">{stat.value}</span>
								<span class="proof-label" aria-hidden="true">{stat.label}</span>
							</dd>
						</div>
					))}
				</dl>
			</div>
		</section>
	)
}

<style>
	.proof {
		display: grid;
		gap: 1rem;
		border-top: 1px solid rgb(var(--line));
		padding: 1.25rem 0 0.5rem;
	}
	.proof-item dd {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		margin: 0;
	}
	.proof-num {
		font-family: var(--font-heading);
		font-size: 2rem;
		line-height: 1;
		color: rgb(var(--accent-ink));
	}
	.proof-label,
	.proof-areas {
		font-family: var(--font-data);
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgb(var(--ink-soft));
	}
	.proof-areas {
		margin: 0;
	}

	@media (min-width: 768px) {
		.proof {
			grid-template-columns: 1fr auto 1fr;
			align-items: baseline;
			gap: 2rem;
		}
		.proof-areas {
			text-align: center;
		}
		.proof-item--end dd {
			justify-content: flex-end;
		}
	}
</style>
