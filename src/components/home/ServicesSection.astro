---
/**
 * «Qué construyo»: índice editorial a todo el ancho.
 * Una fila por capacidad: número, título grande en serif, descripción,
 * stack y proyectos donde se ve. Al pasar el ratón, la fila se resalta
 * con una franja de acento que entra desde la izquierda.
 */
import Section from "../ui/Section.astro";
import { capabilities } from "../../data/home";
---

<Section
	id="capacidades"
	index="02"
	eyebrow="Qué construyo"
	title="Lo que sé hacer, <em class='t-accent'>con pruebas.</em>"
	intro="Cada capacidad enlaza al proyecto donde se puede ver funcionando."
>
	<ol class="border-b border-ink">
		{
			capabilities.map((cap, i) => (
				<li class="cap-row group relative border-t border-ink">
					<span aria-hidden="true" class="cap-sweep" />
					<div class="relative grid gap-4 py-8 md:grid-cols-12 md:items-baseline md:gap-6 md:py-10">
						<p class="t-data text-accent-ink md:col-span-1">{String(i + 1).padStart(2, "0")}</p>

						<h3 class="cap-title font-heading text-ink md:col-span-5">
							{cap.title}
						</h3>

						<div class="md:col-span-6">
							<p class="max-w-[48ch] text-ink-soft">{cap.summary}</p>
							<p class="t-data mt-4 uppercase tracking-wider text-ink-muted">{cap.tech.join(" · ")}</p>
							<p class="t-data mt-3 flex flex-wrap gap-x-4 gap-y-1 uppercase tracking-wider">
								<span class="text-ink-muted">Dónde verlo</span>
								{cap.proof.map((proof) => (
									<a href={proof.href} class="link-underline text-ink hover:text-accent-ink">
										{proof.label} <span aria-hidden="true">↗</span>
									</a>
								))}
							</p>
						</div>
					</div>
				</li>
			))
		}
	</ol>
</Section>

<style>
	.cap-title {
		font-size: clamp(2.1rem, 1.4rem + 2.6vw, 3.75rem);
		line-height: 0.98;
		letter-spacing: -0.015em;
		transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1), color 0.3s;
	}

	/* Franja de acento que entra desde la izquierda al pasar por la fila. */
	.cap-sweep {
		position: absolute;
		inset: 0;
		background: rgb(var(--accent) / 0.1);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	@media (hover: hover) {
		.cap-row:hover .cap-sweep,
		.cap-row:focus-within .cap-sweep {
			transform: scaleX(1);
		}
		.cap-row:hover .cap-title,
		.cap-row:focus-within .cap-title {
			transform: translateX(0.75rem);
			color: rgb(var(--accent-ink));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cap-title,
		.cap-sweep {
			transition: none;
		}
	}
</style>
