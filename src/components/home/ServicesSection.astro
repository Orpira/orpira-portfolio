---
import Section from "../ui/Section.astro";
import Tag from "../ui/Tag.astro";
import { capabilities } from "../../data/home";
---

<Section
	id="capacidades"
	index="02"
	eyebrow="Qué construyo"
	title="Lo que sé hacer, <em class='t-accent'>con pruebas.</em>"
	intro="Cada capacidad enlaza al proyecto donde se puede ver funcionando."
>
	<ul class="grid gap-px overflow-hidden rounded-ds-lg border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
		{
			capabilities.map((cap, i) => (
				<li class="flex flex-col bg-paper p-7 md:p-8">
					<p class="t-data text-accent-ink">{String(i + 1).padStart(2, "0")}</p>
					<h3 class="t-h3 mt-5">{cap.title}</h3>
					<p class="mt-3 text-ink-soft">{cap.summary}</p>
					<div class="mt-5 flex flex-wrap gap-1.5">
						{cap.tech.map((t) => <Tag>{t}</Tag>)}
					</div>
					<div class="mt-auto pt-8">
					<p class="t-data border-t border-line pt-5 text-ink-muted">
						Dónde verlo:{" "}
						{cap.proof.map((p, j) => (
							<>
								{j > 0 && " · "}
								<a href={p.href} class="link-underline text-ink-soft hover:text-ink">{p.label}</a>
							</>
						))}
					</p>
					</div>
				</li>
			))
		}
	</ul>
</Section>
