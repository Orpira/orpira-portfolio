---
/**
 * «Qué construyo» en persiana horizontal.
 * Filas a todo el ancho; la abierta se despliega hacia abajo con la
 * descripción, el stack y los proyectos donde se ve. Una abierta cada vez.
 * Se abre al pasar el ratón por la cabecera, con clic o con teclado. El hover
 * tiene una espera y un bloqueo breves (ver src/scripts/persiana.ts) para que
 * el cambio de altura de las filas no encadene aperturas.
 */
import Section from "../ui/Section.astro";
import { capabilities } from "../../data/home";
---

<Section
	id="capacidades"
	index="02"
	eyebrow="Qué construyo"
	title="Lo que sé hacer, <em class='t-accent'>con pruebas.</em>"
	intro="Pasa por cada capacidad para ver dónde la he aplicado."
>
	<div class="persiana-h" data-persiana data-hover="head" data-anchor>
		{
			capabilities.map((cap, i) => {
				const num = String(i + 1).padStart(2, "0");
				const headId = `cap-head-${i}`;
				const bodyId = `cap-body-${i}`;
				const active = i === 0;
				return (
					<article class="strip" data-strip data-active={active ? "true" : "false"}>
						<h3 class="m-0">
							<button
								type="button"
								id={headId}
								class="strip-head"
								aria-expanded={active ? "true" : "false"}
								aria-controls={bodyId}
								data-strip-head
							>
								<span class="t-data strip-num">{num}</span>
								<span class="strip-label font-heading">{cap.title}</span>
								<span aria-hidden="true" class="strip-icon" />
							</button>
						</h3>
						<div id={bodyId} class="strip-body" role="region" aria-labelledby={headId} inert={!active}>
							<div class="strip-inner">
								<p class="max-w-[48ch] text-[1.0625rem] leading-relaxed text-ink-soft">{cap.summary}</p>
								<div>
									<p class="t-data uppercase tracking-wider text-ink-muted">{cap.tech.join(" · ")}</p>
									<p class="t-data mt-3 flex flex-wrap gap-x-4 gap-y-1 uppercase tracking-wider">
										<span class="text-ink-muted">Dónde verlo</span>
										{cap.proof.map((proof) => (
											<a href={proof.href} class="link-underline text-ink hover:text-accent-ink">
												{proof.label} <span aria-hidden="true">↗</span>
											</a>
										))}
									</p>
								</div>
							</div>
						</div>
					</article>
				);
			})
		}
	</div>
</Section>

<script>
	import "../../scripts/persiana";
</script>

<style>
	.persiana-h {
		/* El scroll lo corrige persiana.ts; que el navegador no lo haga por su cuenta. */
		overflow-anchor: none;
		border-top: 1px solid rgb(var(--ink));
		border-bottom: 1px solid rgb(var(--ink));
	}
	.strip {
		border-top: 1px solid rgb(var(--line));
		transition: background-color 0.4s;
	}
	.strip:first-child {
		border-top: 0;
	}
	.strip[data-active="true"] {
		background: rgb(var(--accent) / 0.08);
	}

	.strip-head {
		display: grid;
		grid-template-columns: 2.5rem 1fr 1.5rem;
		align-items: baseline;
		width: 100%;
		gap: 0.75rem;
		padding: 1.25rem 0.5rem;
		text-align: left;
		cursor: pointer;
	}
	.strip-head:focus-visible {
		outline: 2px solid rgb(var(--accent-ink));
		outline-offset: -2px;
	}
	.strip-num {
		color: rgb(var(--accent-ink));
	}
	.strip-label {
		font-size: clamp(1.6rem, 1.1rem + 2vw, 3rem);
		line-height: 1;
		letter-spacing: -0.015em;
		color: rgb(var(--ink));
		transition:
			transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
			color 0.3s;
	}
	.strip-head:hover .strip-label,
	.strip[data-active="true"] .strip-label {
		color: rgb(var(--accent-ink));
	}
	.strip-head:hover .strip-label {
		transform: translateX(0.5rem);
	}

	/* Indicador + / − */
	.strip-icon {
		position: relative;
		align-self: center;
		width: 1.1rem;
		height: 1.1rem;
	}
	.strip-icon::before,
	.strip-icon::after {
		content: "";
		position: absolute;
		left: 0;
		top: 50%;
		width: 100%;
		height: 1.5px;
		background: rgb(var(--ink));
		transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	.strip-icon::after {
		transform: rotate(90deg);
	}
	.strip[data-active="true"] .strip-icon::after {
		transform: rotate(0deg);
	}

	.strip-body {
		max-height: 0;
		overflow: hidden;
		opacity: 0;
		transition:
			max-height 0.5s cubic-bezier(0.2, 0.7, 0.2, 1),
			opacity 0.3s;
	}
	.strip[data-active="true"] .strip-body {
		max-height: 24rem;
		opacity: 1;
	}
	.strip-inner {
		display: grid;
		gap: 1.25rem;
		padding: 0 0.5rem 1.75rem calc(2.5rem + 1.25rem);
	}

	@media (min-width: 768px) {
		.strip-head {
			grid-template-columns: 4rem 1fr 1.5rem;
			padding: 1.5rem 0.75rem;
		}
		.strip-inner {
			grid-template-columns: 1.1fr 1fr;
			gap: 2.5rem;
			align-items: start;
			padding: 0 0.75rem 2rem calc(4rem + 1.5rem);
		}
	}
	@media (max-width: 767px) {
		.strip-inner {
			padding-left: 0.5rem;
		}
	}

	/* Cierre instantáneo de la franja anterior en pantallas táctiles (persiana.ts). */
	.strip[data-instant] .strip-body {
		transition: none !important;
	}

	@media (prefers-reduced-motion: reduce) {
		.strip,
		.strip-body,
		.strip-label,
		.strip-icon::before,
		.strip-icon::after {
			transition: none !important;
		}
	}
</style>
