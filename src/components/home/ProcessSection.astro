---
import Section from "../ui/Section.astro";
import Pending from "../ui/Pending.astro";
import { steps, supportDays, isProduction } from "../../data/home";
---

<Section
	id="proceso"
	index="03"
	eyebrow="Cómo trabajo"
	title="De la primera llamada <em class='t-accent'>al despliegue.</em>"
>
	<ol class="grid gap-10 md:grid-cols-4 md:gap-8">
		{
			steps.map((step, i) => (
				<li class="reveal border-t border-ink pt-6">
					<p class="font-heading text-5xl leading-none text-accent-ink">{i + 1}</p>
					<h3 class="t-h3 mt-5">{step.title}</h3>
					<p class="mt-2 text-ink-soft">{step.detail}</p>
				</li>
			))
		}
	</ol>
	{
		(supportDays.value || !isProduction) && (
			<p class="t-data mt-12 text-ink-muted">
				Soporte tras el despliegue:{" "}
				{supportDays.value ? (
					<span class="text-ink-soft">{supportDays.value} {supportDays.label}</span>
				) : (
					<Pending hint={supportDays.pendingHint} />
				)}
			</p>
		)
	}
</Section>
