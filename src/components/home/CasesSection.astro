---
/**
 * Proyectos en persiana vertical.
 * - Escritorio: franjas verticales en una fila de altura fija. La activa se
 *   abre a lo ancho con la captura, el estado, el resumen, el stack y el
 *   enlace al proyecto; el resto muestra número y título en vertical.
 * - Móvil: la misma persiana apilada (acordeón), una abierta cada vez.
 */
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Section from "../ui/Section.astro";
import Tag from "../ui/Tag.astro";

// Los casos salen de la colección (src/content/cases): una sola fuente de verdad.
const cases = (await getCollection("cases")).sort((a, b) => a.data.order - b.data.order);
---

<Section
	id="casos"
	index="01"
	eyebrow="Proyectos"
	title="Producto propio, <em class='t-accent'>en producción.</em>"
	intro="Cuatro proyectos que muestran cómo construyo. Pasa por cada franja para abrirla."
>
	<div class="persiana-v" data-persiana data-hover data-anchor>
		{
			cases.map((entry, i) => {
				const c = entry.data;
				const num = String(i + 1).padStart(2, "0");
				const headId = `case-head-${i}`;
				const bodyId = `case-body-${i}`;
				const active = i === 0;
				return (
					<article class="strip" data-strip data-active={active ? "true" : "false"}>
						<h3 class="strip-h3">
							<button
								type="button"
								id={headId}
								class="strip-head"
								aria-expanded={active ? "true" : "false"}
								aria-controls={bodyId}
								data-strip-head
							>
								<span class="t-data strip-num">{num}</span>
								<span class="strip-label font-heading">{c.title}</span>
							</button>
						</h3>
						<div id={bodyId} class="strip-body" role="region" aria-labelledby={headId} inert={!active}>
							{c.cover && (
								<a href={`/casos/${entry.id}`} class="strip-media block overflow-hidden rounded-ds-md border border-line bg-surface" tabindex="-1" aria-hidden="true">
									<Image
										src={c.cover as ImageMetadata}
										alt=""
										widths={[480, 800, 1100]}
										sizes="(min-width: 768px) 46vw, 100vw"
										loading="lazy"
										class="h-full w-full object-cover object-top"
									/>
								</a>
							)}
							<div class="strip-text">
								<div class="flex flex-wrap items-center gap-3">
									<Tag variant="status" status={c.status}>{c.statusLabel}</Tag>
									<span class="t-data text-ink-muted">{c.role.split(" · ").slice(0, 3).join(" · ")}</span>
								</div>
								<p class="strip-title font-heading text-ink">{c.title}</p>
								<p class="mt-3 max-w-[52ch] text-ink-soft">{c.summary}</p>
								<div class="mt-5 flex flex-wrap items-center justify-between gap-4">
									<p class="t-data uppercase tracking-wider text-ink-muted">{c.tags.join(" · ")}</p>
									<a href={`/casos/${entry.id}`} class="t-data link-underline uppercase tracking-wider text-ink hover:text-accent-ink">
										Ver proyecto <span aria-hidden="true">→</span>
									</a>
								</div>
							</div>
						</div>
					</article>
				);
			})
		}
	</div>
</Section>

<script>
	import "../../scripts/persiana";
</script>

<style>
	.persiana-v {
		/* El scroll lo corrige persiana.ts; que el navegador no lo haga por su cuenta. */
		overflow-anchor: none;
		display: flex;
		flex-direction: column;
		border-top: 1px solid rgb(var(--ink));
		border-bottom: 1px solid rgb(var(--ink));
	}

	.strip {
		position: relative;
		border-top: 1px solid rgb(var(--line));
		transition: background-color 0.4s;
	}
	.strip:first-child {
		border-top: 0;
	}
	.strip[data-active="true"] {
		background: rgb(var(--accent) / 0.08);
	}
	.strip-h3 {
		margin: 0;
	}
	.strip-head {
		display: flex;
		width: 100%;
		align-items: baseline;
		gap: 1rem;
		padding: 1.25rem 0.25rem;
		text-align: left;
		cursor: pointer;
	}
	.strip-head:focus-visible {
		outline: 2px solid rgb(var(--accent-ink));
		outline-offset: -2px;
	}
	.strip-num {
		color: rgb(var(--accent-ink));
	}
	.strip-label {
		font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.1rem);
		line-height: 1.05;
		color: rgb(var(--ink));
	}

	/* Móvil: acordeón. */
	.strip-body {
		max-height: 0;
		overflow: hidden;
		padding: 0 0.25rem;
		opacity: 0;
		transition:
			max-height 0.55s cubic-bezier(0.2, 0.7, 0.2, 1),
			opacity 0.3s,
			padding 0.55s;
	}
	.strip[data-active="true"] .strip-body {
		max-height: 48rem;
		opacity: 1;
		padding-bottom: 1.75rem;
	}
	.strip-media {
		aspect-ratio: 16 / 10;
	}
	.strip-text {
		margin-top: 1.25rem;
	}
	.strip-title {
		display: none;
	}

	/* Escritorio: persiana vertical de altura fija. */
	@media (min-width: 768px) {
		.persiana-v {
			flex-direction: row;
			height: 38rem;
			/* La franja abierta ocupa 7/10 del ancho: el panel se dimensiona con eso
			   desde el principio para que el texto no se reacomode durante la animación. */
			container-type: inline-size;
		}
		.strip {
			flex: 1 1 0;
			min-width: 0;
			overflow: hidden;
			border-top: 0;
			border-left: 1px solid rgb(var(--line));
			transition:
				flex-grow 0.6s cubic-bezier(0.2, 0.7, 0.2, 1),
				background-color 0.4s;
		}
		.strip:first-child {
			border-left: 0;
		}
		.strip[data-active="true"] {
			flex-grow: 7;
		}

		.strip-head {
			position: absolute;
			inset: 0;
			flex-direction: column;
			justify-content: space-between;
			align-items: flex-start;
			padding: 1.5rem 1.25rem;
		}
		.strip-label {
			writing-mode: vertical-rl;
			transform: rotate(180deg);
			white-space: nowrap;
			transition: opacity 0.25s;
		}
		.strip[data-active="true"] .strip-head {
			pointer-events: none;
		}
		.strip[data-active="true"] .strip-label {
			opacity: 0;
		}

		.strip-body {
			position: absolute;
			inset: 0;
			display: flex;
			flex-direction: column;
			width: calc(70cqw - 2px);
			max-height: none;
			padding: 3.5rem 1.75rem 1.75rem 1.25rem;
			opacity: 0;
			transform: translateY(0.75rem);
			transition:
				opacity 0.3s,
				transform 0.4s;
		}
		.strip[data-active="true"] .strip-body {
			max-height: none;
			padding-bottom: 1.75rem;
			opacity: 1;
			transform: none;
			transition:
				opacity 0.4s 0.2s,
				transform 0.5s 0.2s;
		}
		.strip-media {
			flex: 1 1 auto;
			min-height: 0;
			aspect-ratio: auto;
		}
		.strip-title {
			display: block;
			margin-top: 0.75rem;
			font-size: clamp(2.2rem, 1.5rem + 2.2vw, 3.4rem);
			line-height: 0.98;
			letter-spacing: -0.015em;
		}
	}

	/* Cierre instantáneo de la franja anterior en pantallas táctiles (persiana.ts). */
	.strip[data-instant] .strip-body {
		transition: none !important;
	}

	@media (prefers-reduced-motion: reduce) {
		.strip,
		.strip-body,
		.strip-label {
			transition: none !important;
		}
	}
</style>
