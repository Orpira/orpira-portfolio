---
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";
import Section from "../ui/Section.astro";
import CaseRow from "../ui/CaseRow.astro";

// Los casos salen de la colección (src/content/cases): una sola fuente de verdad.
const cases = (await getCollection("cases")).sort((a, b) => a.data.order - b.data.order);
---

<Section
	id="casos"
	index="01"
	eyebrow="Proyectos"
	title="Producto propio, <em class='t-accent'>en producción.</em>"
	intro="Cuatro productos propios que muestran cómo construyo: un examen en Word convertido en app para un curso real, aprendizaje con IA, finanzas con privacidad y un juego en tiempo real."
>
	<ol class="list-none">
		{
			cases.map((entry, i) => (
				<CaseRow
					index={String(i + 1).padStart(2, "0")}
					title={entry.data.title}
					result={entry.data.summary}
					href={`/casos/${entry.id}`}
					role={entry.data.role.split(" · ").slice(0, 3).join(" · ")}
					tags={entry.data.tags}
					image={entry.data.cover as ImageMetadata | undefined}
					imageAlt={entry.data.coverAlt}
					status={entry.data.status}
					statusLabel={entry.data.statusLabel}
				/>
			))
		}
	</ol>
</Section>
