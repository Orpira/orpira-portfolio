---
import { Image } from "astro:assets";
import Section from "../ui/Section.astro";
import Tag from "../ui/Tag.astro";
import portrait from "../../assets/images/orpira-hero-professional.png";
import { about } from "../../data/home";
---

<Section id="sobre-mi" index="04" eyebrow="Sobre mí" title={about.title}>
	<div class="grid gap-10 md:grid-cols-12 md:gap-12">
		<div class="md:col-span-4 md:col-start-1">
			<Image
				src={portrait}
				alt="Orlando Pineda Raad sonriendo en su puesto de trabajo, frente a una pantalla con código"
				widths={[360, 560, 760]}
				sizes="(min-width: 768px) 30vw, 100vw"
				format="avif"
				quality={78}
				loading="lazy"
				class="aspect-[4/5] w-full rounded-ds-lg border border-line object-cover object-[50%_18%]"
			/>
		</div>
		<div class="md:col-span-7 md:col-start-6">
			<div class="space-y-5 text-[1.125rem] leading-relaxed">
				{about.paragraphs.map((p) => <p>{p}</p>)}
			</div>
			<p class="t-data mt-10 text-ink-muted">Herramientas de cada día</p>
			<ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Stack técnico">
				{
					about.stack.map((tech) => (
						<li>
							<Tag>{tech}</Tag>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</Section>
