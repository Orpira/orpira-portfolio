---
/**
 * Contacto (fase 2C). Usa la misma API que el formulario anterior
 * (POST /api/contact con name, email, message, botcheck, consent).
 * El campo «¿Qué necesitas?» se antepone al mensaje para no cambiar
 * ni la API ni la tabla de Supabase.
 */
import Section from "../ui/Section.astro";
import Button from "../ui/Button.astro";
import { contact } from "../../data/home";

const field =
	"mt-2 block w-full rounded-ds-md border border-line bg-paper px-4 py-3 text-ink placeholder:text-ink-muted/80 transition-colors focus:border-ink focus:outline-none focus:ring-0 aria-[invalid=true]:border-red-600 dark:aria-[invalid=true]:border-red-400";
const errorText = "mt-1.5 hidden text-sm text-red-700 dark:text-red-300";
---

<Section id="contacto" index="06" eyebrow="Contacto" title={contact.title}>
	<div class="grid gap-12 md:grid-cols-12">
		<div class="md:col-span-4">
			<p class="t-lead">{contact.intro}</p>

			<p class="t-data mt-10 text-ink-muted">¿Prefieres otro canal?</p>
			<ul class="mt-3 space-y-2">
				<li>
					<a class="link-underline text-ink" href={contact.whatsapp} target="_blank" rel="noopener noreferrer">
						WhatsApp <span aria-hidden="true">↗</span><span class="sr-only"> (se abre en otra pestaña)</span>
					</a>
				</li>
				<li>
					<a class="link-underline text-ink" href={contact.linkedin} target="_blank" rel="noopener noreferrer">
						LinkedIn <span aria-hidden="true">↗</span><span class="sr-only"> (se abre en otra pestaña)</span>
					</a>
				</li>
			</ul>
		</div>

		<form
			id="contact-form"
			class="md:col-span-7 md:col-start-6"
			novalidate
			aria-describedby="form-required-note"
		>
			<p id="form-required-note" class="t-data mb-6 text-ink-muted">Todos los campos son obligatorios.</p>

			<!-- Trampa para bots: oculta a personas y a lectores de pantalla -->
			<div class="hidden" aria-hidden="true">
				<label>No rellenar <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" /></label>
			</div>


			<div class="mt-7 grid gap-6 sm:grid-cols-2">
				<div>
					<label for="cf-name" class="font-medium text-ink">Nombre</label>
					<input
						id="cf-name"
						name="name"
						type="text"
						autocomplete="name"
						required
						minlength="2"
						maxlength="100"
						class={field}
						aria-describedby="cf-name-error"
					/>
					<p id="cf-name-error" class={errorText}>Escribe tu nombre (mínimo 2 caracteres).</p>
				</div>
				<div>
					<label for="cf-email" class="font-medium text-ink">Email</label>
					<input
						id="cf-email"
						name="email"
						type="email"
						autocomplete="email"
						inputmode="email"
						required
						maxlength="254"
						class={field}
						aria-describedby="cf-email-error"
					/>
					<p id="cf-email-error" class={errorText}>Escribe un email válido, por ejemplo nombre@empresa.es.</p>
				</div>
			</div>

			<div class="mt-6">
				<label for="cf-message" class="font-medium text-ink">Mensaje</label>
				<textarea
					id="cf-message"
					name="message"
					rows="5"
					required
					minlength="10"
					maxlength="4900"
					placeholder="Sobre qué proyecto, idea o duda quieres escribirme."
					class:list={[field, "resize-y"]}
					aria-describedby="cf-message-error"></textarea>
				<p id="cf-message-error" class={errorText}>El mensaje necesita al menos 10 caracteres.</p>
			</div>

			<div class="mt-6">
				<label class="flex items-start gap-3 text-[0.9375rem]">
					<input
						id="cf-consent"
						type="checkbox"
						name="consent"
						required
						class="mt-1 size-4 rounded-[4px] border-line text-accent-ink focus:ring-accent-ink"
						aria-describedby="cf-consent-error"
					/>
					<span>
						He leído y acepto la <a href="/privacidad" class="underline hover:text-ink">política de privacidad</a>.
					</span>
				</label>
				<p id="cf-consent-error" class={errorText}>Necesito tu consentimiento para responderte.</p>
			</div>

			<div class="mt-8 flex flex-wrap items-center gap-4">
				<Button type="submit" size="lg" arrow id="cf-submit">Enviar mensaje</Button>
				<p id="cf-status" role="status" aria-live="polite" class="text-[0.9375rem]"></p>
			</div>
		</form>
	</div>
</Section>

<style>
	.need-chip span {
		display: inline-flex;
		align-items: center;
		height: 2.5rem;
		padding-inline: 1rem;
		border: 1px solid rgb(var(--line));
		border-radius: 999px;
		font-size: 0.9375rem;
		color: rgb(var(--ink-soft));
		cursor: pointer;
		transition:
			background-color 0.2s,
			border-color 0.2s,
			color 0.2s;
	}

	.need-chip:hover span {
		border-color: rgb(var(--ink) / 0.5);
	}

	.need-chip input:checked + span {
		background: rgb(var(--ink));
		border-color: rgb(var(--ink));
		color: rgb(var(--paper));
	}

	.need-chip input:focus-visible + span {
		outline: 2px solid rgb(var(--accent-ink));
		outline-offset: 3px;
	}
</style>

<script>
	const form = document.querySelector<HTMLFormElement>("#contact-form");
	const status = document.querySelector<HTMLElement>("#cf-status");
	const submit = document.querySelector<HTMLButtonElement>("#cf-submit");

	type Field = HTMLInputElement | HTMLTextAreaElement;

	const showError = (input: Field, show: boolean) => {
		const error = document.getElementById(`${input.id}-error`);
		input.setAttribute("aria-invalid", String(show));
		error?.classList.toggle("hidden", !show);
	};

	const validate = (input: Field) => {
		const valid = input.checkValidity();
		showError(input, !valid);
		return valid;
	};

	const setStatus = (text: string, tone: "ok" | "error" | "info") => {
		if (!status) return;
		status.textContent = text;
		status.className = {
			ok: "text-[0.9375rem] text-emerald-700 dark:text-emerald-300",
			error: "text-[0.9375rem] text-red-700 dark:text-red-300",
			info: "text-[0.9375rem] text-ink-muted",
		}[tone];
	};

	if (form && submit) {
		const fields = Array.from(
			form.querySelectorAll<Field>("#cf-name, #cf-email, #cf-message, #cf-consent"),
		);

		// Valida al salir del campo y corrige en vivo una vez marcado el error.
		fields.forEach((input) => {
			input.addEventListener("blur", () => {
				if (input.value || input.type === "checkbox") validate(input);
			});
			input.addEventListener("input", () => {
				if (input.getAttribute("aria-invalid") === "true") validate(input);
			});
			input.addEventListener("change", () => {
				if (input.type === "checkbox") validate(input);
			});
		});

		form.addEventListener("submit", async (event) => {
			event.preventDefault();
			const results = fields.map(validate);
			const firstInvalid = fields[results.indexOf(false)];
			if (firstInvalid) {
				firstInvalid.focus();
				setStatus("Revisa los campos marcados.", "error");
				return;
			}

			const data = new FormData(form);
			const need = String(data.get("need") ?? "").trim();
			const message = String(data.get("message") ?? "").trim();

			submit.disabled = true;
			submit.setAttribute("aria-busy", "true");
			setStatus("Enviando…", "info");

			try {
				const response = await fetch("/api/contact", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({
						name: String(data.get("name") ?? "").trim(),
						email: String(data.get("email") ?? "").trim(),
						message: need ? `[${need}] ${message}` : message,
						botcheck: data.get("botcheck") !== null,
						consent: data.get("consent") !== null,
					}),
				});
				const result = await response.json().catch(() => ({}));

				if (response.ok && result.success) {
					form.reset();
					fields.forEach((input) => showError(input, false));
					setStatus(
						"Mensaje enviado. Te llegará una confirmación por email y te responderé personalmente.",
						"ok",
					);
				} else {
					setStatus(result.error ?? "No se pudo enviar. Prueba de nuevo o escríbeme por WhatsApp.", "error");
				}
			} catch {
				setStatus("Sin conexión. Prueba de nuevo o escríbeme por WhatsApp.", "error");
			} finally {
				submit.disabled = false;
				submit.removeAttribute("aria-busy");
			}
		});
	}
</script>
