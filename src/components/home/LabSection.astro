---
import DemoGuard from "../DemoGuard.astro";
import Section from "../ui/Section.astro";
import Tag from "../ui/Tag.astro";
import Pending from "../ui/Pending.astro";
import LabArt from "./LabArt.astro";
import CursorCube from "../CursorCube.astro";
import { getCollection } from "astro:content";
import { labProjects, isProduction } from "../../data/home";

// Casos de estudio del Laboratorio, por título.
const caseByTitle = new Map(
	(await getCollection("cases", (e) => e.data.section === "laboratorio")).map((e) => [e.data.title, `/casos/${e.id}`]),
);
---

<Section
	id="laboratorio"
	index="02"
	eyebrow="Laboratorio"
	title="Prototipos y pilotos <em class='t-accent'>en evolución.</em>"
	intro="MVPs, pilotos y herramientas que siguen creciendo. Cuando uno se asienta con uso real, pasa a Proyectos."
>
	<CursorCube zone="#laboratorio" hideOver="a, button" />
	{/* Cinta en bucle con las tarjetas en una fila. Se para al pasar el ratón o enfocar
	   una tarjeta, se arrastra con el dedo y las flechas van fuera de las tarjetas para no
	   tapar sus botones. */}
	<div class="cinta" data-cinta>
		<div class="cinta-controls">
			<button type="button" class="cinta-btn" data-cinta-prev aria-label="Proyectos anteriores">
				<span aria-hidden="true">←</span>
			</button>
			<button type="button" class="cinta-btn" data-cinta-next aria-label="Más proyectos">
				<span aria-hidden="true">→</span>
			</button>
		</div>
		<div class="cinta-viewport" data-cinta-viewport>
	<ul class="cinta-track" data-cinta-track role="list">
		{
			labProjects.map((project, i) => {
				const caseHref = caseByTitle.get(project.title);
				// Con caso de estudio, el botón de la app se protege con DemoGuard (vídeo si la demo no responde).
				const demoSlug = caseHref?.split("/").filter(Boolean).pop();
				const host = project.href ? new URL(project.href).hostname : "demo local";
				const titleHref = caseHref ?? project.href;
				return (
					<li class="cinta-item">
						<article class="lab-card" data-card style={`--tone: ${project.tone}`}>
							<div class="lab-stage" aria-hidden="true">
								<div class="lab-window">
									<div class="lab-bar">
										<span /><span /><span />
										<em>{host}</em>
									</div>
									<LabArt art={project.art} />
								</div>
							</div>
							<div class="lab-body">
								<div class="flex items-center justify-between gap-3">
									<span class="t-data text-ink-muted">L—{String(i + 1).padStart(2, "0")}</span>
									<Tag variant="status" status={project.status}>
										{project.statusLabel}
									</Tag>
								</div>
								<h3 class="mt-4 font-heading text-[1.75rem] leading-[1.05] text-ink">
									{titleHref ? (
										<a href={titleHref} class="lab-title" {...(!caseHref ? { target: "_blank", rel: "noopener noreferrer" } : {})}>
											{project.title}
										</a>
									) : (
										project.title
									)}
								</h3>
								<p class="lab-summary mt-3 text-[0.9375rem] leading-relaxed text-ink-soft">
									{project.summary}
								</p>
								<div class="mt-5 flex flex-wrap items-center gap-1.5">
									{project.tags.map((tag) => (
										<Tag>{tag}</Tag>
									))}
									{!project.href && !isProduction && project.pendingHint && (
										<Pending hint={project.pendingHint} />
									)}
								</div>
								<div class="lab-actions">
									{caseHref && (
										<a class="lab-btn lab-btn--case" href={caseHref}>
											Caso de estudio<span class="sr-only"> de {project.title}</span>
											<span aria-hidden="true" class="lab-arrow">→</span>
										</a>
									)}
									{project.href && (
										<a
											class="lab-btn lab-btn--app"
											href={project.href}
											target="_blank"
											rel="noopener noreferrer"
											{...(demoSlug ? { "data-demo": demoSlug, "data-demo-video": demoSlug === "inout" ? "demo-inout" : "demo", "data-demo-title": project.title } : {})}
										>
											<span data-demo-label>Abrir la app</span><span class="sr-only" data-demo-sr> {project.title} (se abre en otra pestaña)</span>
											<span aria-hidden="true" class="lab-arrow" data-demo-arrow>↗</span>
										</a>
									)}
								</div>
							</div>
						</article>
					</li>
				);
			})
		}
	</ul>
		</div>
	</div>
</Section>

<script>
	import "../../scripts/cinta";
</script>

<style>
	/* La cinta va entre los márgenes del contenido: las tarjetas entran y salen
	   por debajo de ese borde, con un corte limpio. */
	.cinta-viewport {
		overflow: hidden;
		/* Aire para que la sombra y la elevación al pasar el ratón no se recorten. */
		padding-block: 1.5rem 3rem;
		margin-block: -1.5rem -3rem;
		touch-action: pan-y;
	}
	.cinta-viewport.is-dragging .lab-card {
		pointer-events: none;
	}
	.cinta-track {
		position: relative;
		display: flex;
		gap: 1.25rem;
		width: max-content;
		will-change: transform;
	}
	/* Sin movimiento: desplazamiento nativo con ajuste por tarjeta. */
	.cinta.is-static .cinta-viewport {
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
		touch-action: auto;
	}
	.cinta.is-static .cinta-viewport::-webkit-scrollbar {
		display: none;
	}
	.cinta.is-static .cinta-item {
		scroll-snap-align: start;
	}

	.cinta {
		position: relative;
	}
	/* Flechas arriba a la derecha, fuera de las tarjetas: no tapan ningún botón. */
	.cinta-controls {
		display: flex;
		justify-content: flex-end;
		gap: 0.5rem;
		margin-bottom: 1rem;
	}
	.cinta-btn {
		display: inline-grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 1px solid rgb(var(--line));
		border-radius: 999px;
		color: rgb(var(--ink));
		transition:
			background-color 0.2s ease,
			border-color 0.2s ease,
			color 0.2s ease;
	}
	.cinta-btn:hover {
		border-color: rgb(var(--ink));
		background: rgb(var(--ink));
		color: rgb(var(--paper));
	}
	.cinta-btn:focus-visible {
		outline: 2px solid rgb(var(--accent));
		outline-offset: 2px;
	}
	.cinta-item {
		display: flex;
		width: clamp(17.5rem, 80vw, 24rem);
		flex: none;
	}

	.lab-card {
		position: relative;
		isolation: isolate;
		display: flex;
		flex: 1;
		flex-direction: column;
		overflow: hidden;
		border: 1px solid rgb(var(--line));
		border-radius: var(--radius-lg);
		background: rgb(var(--paper));
		transition:
			border-color 0.25s ease,
			box-shadow 0.35s ease;
	}
	/* Halo que sigue al puntero. */
	.lab-card::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		background: radial-gradient(
			320px circle at var(--mx, 50%) var(--my, 0%),
			rgb(var(--tone) / 0.12),
			transparent 70%
		);
		opacity: 0;
		transition: opacity 0.3s ease;
		pointer-events: none;
	}
	/* Al pasar por encima la tarjeta no se desplaza: así los botones no se mueven
	   bajo el puntero. Solo cambian el borde, la sombra y la ventana de la portada. */
	.lab-card:hover,
	.lab-card:focus-within {
		border-color: rgb(var(--ink) / 0.3);
		box-shadow: 0 18px 40px -26px rgb(var(--ink) / 0.35);
	}
	.lab-card:hover::before,
	.lab-card:focus-within::before {
		opacity: 1;
	}

	/* Portada: el color del proyecto con su pantalla en una ventana inclinada. */
	.lab-stage {
		position: relative;
		overflow: hidden;
		aspect-ratio: 16 / 8.5;
		padding: 1.75rem 9% 0;
		background:
			radial-gradient(120% 90% at 85% 0%, rgb(255 255 255 / 0.18), transparent 60%),
			rgb(var(--tone));
		perspective: 900px;
	}
	.lab-stage::after {
		content: "";
		position: absolute;
		inset: 0;
		background-image: radial-gradient(rgb(255 255 255 / 0.16) 1px, transparent 1px);
		background-size: 14px 14px;
		pointer-events: none;
	}
	.lab-window {
		position: relative;
		z-index: 1;
		overflow: hidden;
		border-radius: 0.75rem 0.75rem 0 0;
		background: #fbfaf7;
		box-shadow: 0 -2px 0 rgb(255 255 255 / 0.25), 0 24px 40px -18px rgb(0 0 0 / 0.55);
		transform: translateY(10px) rotateX(10deg);
		transform-origin: 50% 100%;
		transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	.lab-bar {
		display: flex;
		align-items: center;
		gap: 5px;
		padding: 0.5rem 0.75rem;
		border-bottom: 1px solid #ece9e2;
		background: #f4f2ed;
	}
	.lab-bar span {
		width: 7px;
		height: 7px;
		border-radius: 999px;
		background: #d8d4cb;
	}
	.lab-bar em {
		margin-left: 0.5rem;
		flex: 1;
		overflow: hidden;
		border-radius: 999px;
		background: #fff;
		padding: 0.1rem 0.6rem;
		color: #8a877f;
		font: 500 0.625rem/1.4 var(--font-mono, ui-monospace, monospace);
		font-style: normal;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.lab-card:hover .lab-window,
	.lab-card:focus-within .lab-window {
		transform: translateY(0) rotateX(0);
	}
	@media (hover: none) {
		.lab-window {
			transform: none;
		}
	}

	.lab-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		padding: 1.25rem 1.5rem 1.5rem;
	}
	.lab-summary {
		display: -webkit-box;
		-webkit-line-clamp: 4;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.lab-title {
		text-decoration: none;
		background-image: linear-gradient(currentColor, currentColor);
		background-size: 0 1px;
		background-position: 0 100%;
		background-repeat: no-repeat;
		transition: background-size 0.25s ease;
	}
	.lab-title:hover,
	.lab-title:focus-visible {
		background-size: 100% 1px;
	}

	/* Acciones al pie de la tarjeta, alineadas entre tarjetas (mt-auto). Botones
	   amplios (44 px de alto) para pincharlos a la primera, también con el dedo. */
	.lab-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.625rem;
		margin-top: auto;
		padding-top: 1.5rem;
	}
	.lab-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		min-height: 2.75rem;
		padding: 0 1.125rem;
		border-radius: 999px;
		font-size: 0.9375rem;
		font-weight: 500;
		white-space: nowrap;
		transition:
			background-color 0.2s ease,
			border-color 0.2s ease,
			color 0.2s ease;
	}
	.lab-btn--case {
		background: rgb(var(--ink));
		color: rgb(var(--paper));
	}
	.lab-btn--case:hover {
		background: rgb(var(--ink) / 0.85);
	}
	.lab-btn--app {
		border: 1px solid rgb(var(--ink) / 0.2);
		color: rgb(var(--ink));
	}
	.lab-btn--app:hover {
		border-color: rgb(var(--ink) / 0.6);
	}
	.lab-btn:focus-visible {
		outline: 2px solid rgb(var(--accent));
		outline-offset: 2px;
	}
	.lab-arrow {
		display: inline-block;
		transition: transform 0.2s ease;
	}
	.lab-btn--case:hover .lab-arrow {
		transform: translateX(3px);
	}
	.lab-btn--app:hover .lab-arrow {
		transform: translate(2px, -2px);
	}
	/* En móvil, los dos botones a lo ancho y en una sola fila. */
	@media (max-width: 480px) {
		.lab-body {
			padding-inline: 1.25rem;
		}
		.lab-actions {
			flex-wrap: nowrap;
			gap: 0.5rem;
		}
		.lab-btn {
			flex: 1;
			padding: 0 0.75rem;
			font-size: 0.875rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.lab-card,
		.lab-window,
		.lab-arrow,
		.lab-title {
			transition: none;
		}
		.lab-window {
			transform: none;
		}
	}
</style>

<DemoGuard />
