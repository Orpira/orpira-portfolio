---
import Section from "../ui/Section.astro";
import Tag from "../ui/Tag.astro";
import Pending from "../ui/Pending.astro";
import LabArt from "./LabArt.astro";
import { labProjects, isProduction } from "../../data/home";

---

<Section
	id="laboratorio"
	index="02"
	eyebrow="Laboratorio"
	title="Prototipos y pilotos <em class='t-accent'>en evolución.</em>"
	intro="MVPs, pilotos y herramientas que siguen creciendo. Cuando uno se asienta con uso real, pasa a Proyectos."
>
	<div class="cinta" data-cinta>
		<div class="cinta-viewport" data-cinta-viewport>
			<ul class="cinta-track" data-cinta-track role="list">
				{
					labProjects.map((project, i) => {
						const Wrapper = project.href ? "a" : "div";
						// Todas las tarjetas abren la app en otra pestaña.
						const attrs = project.href
							? { href: project.href, target: "_blank", rel: "noopener noreferrer" }
							: {};
						return (
							<li class="cinta-item">
								<Wrapper {...attrs} class="lab-card group" data-card style={`--tone: ${project.tone}`}>
									<div class="lab-stage">
										<div class="lab-window">
											<div class="lab-bar">
												<span /><span /><span />
												<em>{project.href ? new URL(project.href).hostname : "demo local"}</em>
											</div>
											<LabArt art={project.art} />
										</div>
									</div>
									<div class="lab-body">
									<div class="flex items-center justify-between gap-3">
										<span class="t-data text-ink-muted">L—{String(i + 1).padStart(2, "0")}</span>
										<Tag variant="status" status={project.status}>
											{project.statusLabel}
										</Tag>
									</div>
									<h3 class="mt-4 font-heading text-[1.75rem] leading-[1.05] text-ink">
										{project.title}
										{project.href && <span class="sr-only"> (se abre en otra pestaña)</span>}
									</h3>
									<p class="lab-summary mt-3 text-[0.9375rem] leading-relaxed text-ink-soft">
										{project.summary}
									</p>
									<div class="mt-auto flex flex-wrap items-center gap-1.5 pt-5">
										{project.tags.map((tag) => (
											<Tag>{tag}</Tag>
										))}
										{!project.href && !isProduction && project.pendingHint && (
											<Pending hint={project.pendingHint} />
										)}
									</div>
									</div>
								</Wrapper>
							</li>
						);
					})
				}
			</ul>
		</div>

		<button type="button" class="cinta-edge cinta-edge--prev" data-cinta-prev aria-label="Proyectos anteriores">
			<span aria-hidden="true">‹</span>
		</button>
		<button type="button" class="cinta-edge cinta-edge--next" data-cinta-next aria-label="Más proyectos">
			<span aria-hidden="true">›</span>
		</button>
	</div>
</Section>

<script>
	import "../../scripts/cinta";
</script>

<style>
	/* La cinta va entre los márgenes del contenido: las tarjetas entran y salen
	   por debajo de ese borde, con un corte limpio. */
	.cinta-viewport {
		overflow: hidden;
		/* Aire para que la sombra y la elevación al pasar el ratón no se recorten. */
		padding-block: 1.5rem 3rem;
		margin-block: -1.5rem -3rem;
		touch-action: pan-y;
		cursor: grab;
	}
	.cinta-viewport.is-dragging {
		cursor: grabbing;
	}
	.cinta-viewport.is-dragging .lab-card {
		pointer-events: none;
	}
	.cinta-track {
		position: relative;
		display: flex;
		gap: 1.25rem;
		width: max-content;
		will-change: transform;
	}
	/* Sin movimiento: desplazamiento nativo con ajuste por tarjeta. */
	.cinta.is-static .cinta-viewport {
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
		cursor: auto;
		touch-action: auto;
	}
	.cinta.is-static .cinta-viewport::-webkit-scrollbar {
		display: none;
	}
	.cinta.is-static .cinta-item {
		scroll-snap-align: start;
	}

	/* Flechas de los extremos, como en Netflix: una franja sobre el borde de la
	   cinta que aparece al pasar el ratón. En táctil se desliza con el dedo. */
	.cinta {
		position: relative;
	}
	.cinta-edge {
		position: absolute;
		top: 0;
		bottom: 0;
		z-index: 2;
		display: grid;
		place-items: center;
		width: 3.5rem;
		color: rgb(var(--ink));
		font-size: 2.75rem;
		line-height: 1;
		opacity: 0;
		transition: opacity 0.25s ease;
	}
	.cinta-edge--prev {
		left: 0;
		background: linear-gradient(to right, rgb(var(--paper)) 15%, rgb(var(--paper) / 0));
		border-radius: var(--radius-lg) 0 0 var(--radius-lg);
	}
	.cinta-edge--next {
		right: 0;
		background: linear-gradient(to left, rgb(var(--paper)) 15%, rgb(var(--paper) / 0));
		border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
	}
	.cinta-edge span {
		transition: transform 0.2s ease;
	}
	.cinta-edge:hover span {
		transform: scale(1.25);
	}
	.cinta-edge:focus-visible {
		opacity: 1;
		outline: 2px solid rgb(var(--accent));
		outline-offset: -2px;
	}
	@media (hover: hover) {
		.cinta:hover .cinta-edge {
			opacity: 1;
		}
	}
	@media (hover: none) {
		.cinta-edge {
			display: none;
		}
	}

	.cinta-item {
		width: clamp(17.5rem, 80vw, 24rem);
		flex: none;
	}

	.lab-card {
		position: relative;
		isolation: isolate;
		display: flex;
		height: 100%;
		flex-direction: column;
		overflow: hidden;
		border: 1px solid rgb(var(--line));
		border-radius: var(--radius-lg);
		background: rgb(var(--paper));
		transition:
			transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1),
			border-color 0.25s ease,
			box-shadow 0.35s ease;
	}
	/* Halo que sigue al puntero. */
	.lab-card::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		background: radial-gradient(
			260px circle at var(--mx, 50%) var(--my, 0%),
			rgb(var(--tone) / 0.14),
			transparent 70%
		);
		opacity: 0;
		transition: opacity 0.3s ease;
	}
	a.lab-card:hover,
	a.lab-card:focus-visible {
		transform: translateY(-6px);
		border-color: rgb(var(--ink) / 0.35);
		box-shadow: 0 18px 40px -24px rgb(var(--ink) / 0.35);
	}
	a.lab-card:hover::before,
	a.lab-card:focus-visible::before {
		opacity: 1;
	}

	/* Portada: el color del proyecto con su pantalla en una ventana inclinada. */
	.lab-stage {
		position: relative;
		overflow: hidden;
		padding: 1.5rem 1.5rem 0;
		background:
			radial-gradient(120% 90% at 85% 0%, rgb(255 255 255 / 0.18), transparent 60%),
			rgb(var(--tone));
		perspective: 900px;
	}
	.lab-stage::after {
		content: "";
		position: absolute;
		inset: 0;
		background-image: radial-gradient(rgb(255 255 255 / 0.16) 1px, transparent 1px);
		background-size: 14px 14px;
		pointer-events: none;
	}
	.lab-window {
		position: relative;
		z-index: 1;
		overflow: hidden;
		border-radius: 0.75rem 0.75rem 0 0;
		background: #fbfaf7;
		box-shadow: 0 -2px 0 rgb(255 255 255 / 0.25), 0 24px 40px -18px rgb(0 0 0 / 0.55);
		transform: translateY(10px) rotateX(10deg);
		transform-origin: 50% 100%;
		transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	.lab-bar {
		display: flex;
		align-items: center;
		gap: 5px;
		padding: 0.5rem 0.75rem;
		border-bottom: 1px solid #ece9e2;
		background: #f4f2ed;
	}
	.lab-bar span {
		width: 7px;
		height: 7px;
		border-radius: 999px;
		background: #d8d4cb;
	}
	.lab-bar em {
		margin-left: 0.5rem;
		flex: 1;
		overflow: hidden;
		border-radius: 999px;
		background: #fff;
		padding: 0.1rem 0.6rem;
		color: #8a877f;
		font: 500 0.625rem/1.4 var(--font-mono, ui-monospace, monospace);
		font-style: normal;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	a.lab-card:hover .lab-window,
	a.lab-card:focus-visible .lab-window {
		transform: translateY(0) rotateX(0);
	}
	/* En táctil no hay "pasar por encima": la ventana va recta. */
	@media (hover: none) {
		.lab-window {
			transform: none;
		}
	}
	.lab-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		padding: 1.25rem 1.5rem 1.5rem;
	}

	.lab-summary {
		display: -webkit-box;
		-webkit-line-clamp: 4;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}



	@media (prefers-reduced-motion: reduce) {
		.lab-card,
		.lab-window,
		.cinta-edge {
			transition: none;
		}
		.lab-window {
			transform: none;
		}
		a.lab-card:hover,
		a.lab-card:focus-visible {
			transform: none;
		}
	}
</style>
