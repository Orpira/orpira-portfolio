---
import { Image } from "astro:assets";
import heroPhoto from "../assets/images/orpira-hero-professional.png";

interface Props {
	baseUrl: string;
}

const capabilities = [
	{
		value: "15+",
		descriptor: "Años en tecnología",
		detail: "Experiencia aplicada a IT, operaciones y desarrollo.",
	},
	{
		value: "FULL STACK",
		descriptor: "Desarrollo end-to-end",
		detail: "Frontend, backend, datos y despliegue.",
	},
	{
		value: "IT",
		descriptor: "Experiencia operativa",
		detail: "Coordinación, soporte, procesos y resolución crítica.",
	},
	{
		value: "PRODUCTO",
		descriptor: "Visión de negocio",
		detail: "Tecnología orientada a necesidades y resultados reales.",
	},
];
---

<section id="top" class="relative pt-20 pb-14 md:pt-20 md:pb-20">
	<div class="hero-layout gap-12">
		<div class="hero-content space-y-7">
			<p class="editorial-kicker micro-label" data-reveal style="--delay: 0ms;">
				FULL STACK · IT · PRODUCTO
			</p>

			<h1
				class="hero-title font-display text-4xl sm:text-5xl lg:text-7xl leading-[0.95] tracking-tight"
				data-reveal
				style="--delay: 90ms;"
			>
				Tecnología con visión de negocio.
			</h1>

			<p
				 class="service-card-copy mt-3 text-sm leading-relaxed md:text-lg"
				data-reveal
				style="--delay: 170ms;"
			>
				Desarrollo productos digitales y soluciones web combinando ingeniería Full Stack, experiencia operativa en IT y enfoque de producto.
			</p>

			<div class="flex flex-wrap gap-3" data-reveal style="--delay: 250ms;">
				<a
					href="#projects"
					class="hero-cta hero-cta-primary rounded-full px-6 py-3 text-sm font-semibold uppercase tracking-[0.1em]"
				>
					Ver proyectos
				</a>
				<a
					href="#services"
					class="hero-cta hero-cta-secondary rounded-full border px-6 py-3 text-sm font-semibold uppercase tracking-[0.1em]"
				>
					Conocer mi experiencia
				</a>
			</div>
		</div>

		<div
			class="hero-visual"
			data-reveal
			style="--delay: 220ms;"
		>
			<div class="hero-portrait-wrap relative">
				<div class="portrait-shell">
					<Image
						src={heroPhoto}
						alt="Orlando Pineda Raad (OrPiRa) trabajando en su puesto, frente a una pantalla con código y el logotipo de OrPiRa"
						class="portrait-image"
						widths={[400, 600, 832, 1097]}
						sizes="(min-width: 1024px) 45vw, 100vw"
						format="avif"
						quality={82}
						loading="eager"
						decoding="async"
						fetchpriority="high"
					/>
				</div>
				<div class="hero-quote">De la idea al deploy.</div>
				<div class="hero-orbit" aria-hidden="true"></div>
			</div>
		</div>

		<div class="hero-capability" data-reveal style="--delay: 310ms;">
			<p class="hero-evidence-line micro-label text-[0.72rem] uppercase tracking-[0.14em]">
				Ingeniería Full Stack · Coordinación IT · Operaciones · Producto
			</p>

			<div class="capability-strip editorial-panel rounded-2xl">
				{
					capabilities.map((item) => (
						<div class="capability-segment">
							<p class="capability-value font-display max-[389px]:text-lg text-xl md:text-2xl text-orange-800 dark:text-orange-100">
								{item.value}
							</p>
							<p class="capability-descriptor micro-label text-[0.66rem] uppercase tracking-[0.12em] mt-1 text-orange-700 dark:text-orange-200">
								{item.descriptor}
							</p>
							<p class="capability-detail service-card-copy text-xs leading-snug mt-1">
								{item.detail}
							</p>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	.hero-layout {
		display: grid;
	}

	@media (min-width: 1024px) {
		.hero-layout {
			grid-template-columns: 1.15fr 1fr;
			grid-template-areas: "content visual" "strip strip";
			align-items: start;
		}

		.hero-content {
			grid-area: content;
		}

		.hero-visual {
			grid-area: visual;
			margin-top: 3rem;
		}

		.hero-capability {
			grid-area: strip;
		}
	}

	.hero-cta {
		transition:
			background-color 0.22s ease,
			color 0.22s ease,
			border-color 0.22s ease,
			transform 0.22s ease,
			box-shadow 0.22s ease;
	}

	.hero-cta:hover {
		transform: translateY(-1px);
	}

	.hero-cta-primary {
		background: #ff9b53;
		color: #18130f;
		box-shadow: 0 10px 24px rgba(255, 155, 83, 0.25);
	}

	.hero-cta-primary:hover {
		background: #ffab6f;
	}

	.hero-cta-secondary {
		color: #1f2937;
		border-color: rgba(31, 41, 55, 0.28);
		background: rgba(255, 255, 255, 0.68);
	}

	.hero-cta-secondary:hover {
		color: #111827;
		border-color: rgba(255, 155, 83, 0.7);
	}

	:global(.dark) .hero-cta-primary {
		background: linear-gradient(145deg, #ffb27b, #ff9b53);
		color: #19120e;
		border: 1px solid rgba(255, 184, 133, 0.6);
		box-shadow:
			0 10px 28px rgba(255, 155, 83, 0.34),
			0 0 0 1px rgba(255, 255, 255, 0.08) inset;
	}

	:global(.dark) .hero-cta-secondary {
		color: #f8f6f1;
		border-color: rgba(255, 255, 255, 0.4);
		background: rgba(248, 246, 241, 0.06);
		box-shadow: 0 10px 24px rgba(6, 8, 14, 0.35);
	}

	:global(.dark) .hero-cta-secondary:hover {
		border-color: rgba(255, 155, 83, 0.78);
		color: #ffd9c2;
	}

	.hero-evidence-line {
		color: #6b7280;
		font-weight: 600;
	}

	:global(.dark) .hero-evidence-line {
		color: #a9b4c9;
	}

	.capability-strip {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		margin-top: 1.25rem;
		padding: 0.25rem;
	}

	.capability-segment {
		border-top: 1px solid transparent;
		border-left: 1px solid transparent;
		padding: 1rem 1.15rem;
	}

	.capability-segment:nth-child(2n) {
		border-left-color: rgba(20, 26, 42, 0.14);
	}

	.capability-segment:nth-child(n + 3) {
		border-top-color: rgba(20, 26, 42, 0.14);
	}

	:global(.dark) .capability-segment:nth-child(2n) {
		border-left-color: rgba(255, 255, 255, 0.12);
	}

	:global(.dark) .capability-segment:nth-child(n + 3) {
		border-top-color: rgba(255, 255, 255, 0.12);
	}

	.capability-value {
		font-weight: 700;
	}

	.capability-descriptor {
		font-weight: 600;
	}

	.capability-detail {
		color: #4b5563;
	}

	:global(.dark) .capability-value {
		text-shadow: 0 6px 16px rgba(255, 155, 83, 0.18);
	}

	:global(.dark) .capability-detail {
		color: #d8e0ef;
	}

	@media (min-width: 1024px) {
		.capability-strip {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}

		.capability-segment:nth-child(n + 3) {
			border-top-color: transparent;
		}

		.capability-segment:nth-child(2n) {
			border-left-color: transparent;
		}

		.capability-segment:not(:first-child) {
			border-left-color: rgba(20, 26, 42, 0.14);
		}

		:global(.dark) .capability-segment:nth-child(n + 3) {
			border-top-color: transparent;
		}

		:global(.dark) .capability-segment:nth-child(2n) {
			border-left-color: transparent;
		}

		:global(.dark) .capability-segment:not(:first-child) {
			border-left-color: rgba(255, 255, 255, 0.12);
		}
	}

	.hero-title {
		color: #111827;
		font-weight: 700;
	}

	:global(.dark) .hero-title {
		color: #f8f6f1;
		text-shadow:
			0 1px 0 rgba(0, 0, 0, 0.45),
			0 8px 22px rgba(0, 0, 0, 0.28);
	}

	.portrait-shell {
		position: relative;
		max-width: 26rem;
		margin-inline: auto;
		padding: 0.85rem;
		border-radius: 1.8rem;
		background: linear-gradient(
			145deg,
			rgba(255, 155, 83, 0.28),
			rgba(77, 136, 255, 0.08),
			rgba(255, 155, 83, 0.2)
		);
		box-shadow:
			0 22px 38px rgba(6, 8, 14, 0.45),
			inset 0 0 0 1px rgba(255, 255, 255, 0.16);
	}

	.portrait-image {
		border-radius: 1.35rem;
		width: 100%;
		height: clamp(21rem, 44vw, 31rem);
		object-fit: cover;
		object-position: 50% 16%;
		filter: saturate(0.94) contrast(1.02);
	}

	.hero-quote {
		position: absolute;
		left: -1rem;
		bottom: 1.2rem;
		padding: 0.75rem 1rem;
		border-radius: 9999px;
		font-family: "JetBrains Mono", monospace;
		font-size: 0.66rem;
		text-transform: uppercase;
		letter-spacing: 0.16em;
		color: #111827;
		background: rgba(255, 237, 221, 0.94);
		box-shadow: 0 8px 22px rgba(0, 0, 0, 0.22);
	}

	:global(.dark) .hero-quote {
		color: #fef2e8;
		background: rgba(19, 23, 35, 0.88);
		border: 1px solid rgba(255, 255, 255, 0.15);
	}

	.hero-orbit {
		position: absolute;
		right: -1.6rem;
		top: -1.4rem;
		width: 6rem;
		height: 6rem;
		border-radius: 9999px;
		border: 1px solid rgba(255, 255, 255, 0.24);
		box-shadow: inset 0 0 0 1px rgba(255, 155, 83, 0.35);
		animation: orbitSpin 11s linear infinite;
	}

	.hero-orbit::after {
		content: "";
		position: absolute;
		inset: 0.9rem;
		border-radius: 9999px;
		border: 1px dashed rgba(255, 155, 83, 0.6);
	}

	@keyframes orbitSpin {
		from {
			transform: rotate(0deg);
		}
		to {
			transform: rotate(360deg);
		}
	}

	@media (max-width: 1023px) {
		.hero-quote {
			left: 50%;
			transform: translateX(-50%);
			bottom: -1rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-orbit {
			animation: none;
			display: none;
		}
	}
</style>
