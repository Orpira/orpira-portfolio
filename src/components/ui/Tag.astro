---
/**
 * Etiqueta técnica en monoespaciada: stack, año, estado.
 * - outline (por defecto): borde fino.
 * - plain: solo texto, para listas separadas por "·".
 * - status: con punto de color (en línea / en desarrollo).
 */
interface Props {
	variant?: "outline" | "plain" | "status";
	status?: "live" | "building";
	class?: string;
}

const { variant = "outline", status = "live", class: className = "" } =
	Astro.props;

const variants = {
	outline: "border border-line px-2 py-0.5 rounded-ds-sm text-ink-muted",
	plain: "text-ink-muted",
	status: "text-ink-soft gap-1.5",
};
---

<span class:list={["t-data inline-flex items-center", variants[variant], className]}>
	{
		variant === "status" && (
			<span
				aria-hidden="true"
				class:list={[
					"inline-block size-1.5 rounded-full",
					status === "live" ? "bg-emerald-600 dark:bg-emerald-400" : "bg-accent",
				]}
			/>
		)
	}
	<slot />
</span>
