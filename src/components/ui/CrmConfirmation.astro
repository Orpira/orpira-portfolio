---
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<dialog id={id} aria-labelledby={`${id}-title`} aria-describedby={`${id}-message`}
  class="m-auto w-[calc(100%-2rem)] max-w-md rounded-xl border border-slate-200 bg-white p-0 text-slate-900 shadow-xl backdrop:bg-slate-950/60">
  <div class="p-5 sm:p-6">
    <h2 id={`${id}-title`} data-confirm-title class="text-lg font-semibold"></h2>
    <p id={`${id}-message`} data-confirm-message class="mt-2 break-words text-sm leading-relaxed text-slate-600"></p>
    <form method="dialog" class="mt-5 flex flex-wrap justify-end gap-2">
      <button value="cancel" autofocus
        class="min-h-11 rounded-lg border border-slate-300 px-4 text-sm font-semibold hover:bg-slate-100">
        Cancelar
      </button>
      <button value="confirm" data-confirm-action
        class="min-h-11 rounded-lg bg-teal-700 px-4 text-sm font-semibold text-white hover:bg-teal-800"></button>
    </form>
  </div>
</dialog>
