<inout-playback class="mb-8 block overflow-hidden rounded-ds-lg border border-line bg-surface">
	<div class="flex flex-wrap items-center justify-between gap-3 border-b border-line px-5 py-4">
		<p class="font-medium text-ink">Recorrido visual · Turno de ejemplo</p>
		<button type="button" data-play hidden class="rounded-full bg-accent px-4 py-2 font-medium text-accent-on">
			Reproducir demostración
		</button>
	</div>
	<div class="grid gap-3 p-4 md:grid-cols-3 md:p-5" aria-label="Tres pantallas de ejemplo">
		<div data-scene class="scene rounded-ds-lg border border-line bg-paper p-4">
			<p class="t-data text-ink-muted">Kiosko · Entrada</p>
			<p class="mt-3 text-3xl font-medium tabular-nums text-ink">08:00</p>
			<div aria-hidden="true" class="mt-3 grid max-w-32 grid-cols-3 gap-1 text-center text-sm">
				{["1", "2", "3", "4", "5", "6", "7", "8", "9", "⌫", "0", "✓"].map((key) => (
					<span class:list={["rounded border border-line p-1", key === "✓" && "key border-accent bg-accent text-accent-on"]}>{key}</span>
				))}
			</div>
			<p class="mt-3 font-medium text-accent-ink">✓ Entrada sincronizada</p>
		</div>
		<div data-scene class="scene rounded-ds-lg border border-line bg-paper p-4">
			<p class="t-data text-ink-muted">Supervisión · Horas extra</p>
			<p class="mt-3 text-3xl font-medium tabular-nums text-ink">45 min</p>
			<p class="text-sm text-ink-soft">Tiempo adicional registrado</p>
			<div aria-hidden="true" class="mt-5 h-3 overflow-hidden rounded-full border border-line bg-surface">
				<div class="fill h-full w-2/3 origin-left bg-accent"></div>
			</div>
			<p class="mt-3 font-medium text-accent-ink">✓ 30 min aprobados</p>
		</div>
		<div data-scene class="scene rounded-ds-lg border border-line bg-paper p-4">
			<p class="t-data text-ink-muted">Liquidación · Resultado</p>
			<div class="receipt mt-4 rounded-lg border border-line bg-surface p-3">
				<p class="text-sm text-ink-soft">Hora extra diurna</p>
				<p class="mt-1 text-3xl font-medium tabular-nums text-ink">00:30</p>
			</div>
			<p class="mt-3 font-medium text-accent-ink">✓ Tiempo liquidado</p>
		</div>
	</div>
	<p data-status hidden role="status" class="border-t border-line px-5 py-3 text-sm text-ink-soft">Selecciona reproducir para seguir el turno.</p>
</inout-playback>

<script>
	class InoutPlayback extends HTMLElement {
		#timer: number | undefined;

		connectedCallback() {
			const button = this.querySelector<HTMLButtonElement>("[data-play]");
			const status = this.querySelector<HTMLElement>("[data-status]");
			const scenes = [...this.querySelectorAll<HTMLElement>("[data-scene]")];
			if (!button || !status || scenes.length !== 3) return;

			const messages = [
				"1 de 3 · El kiosko sincroniza la entrada de las 08:00.",
				"2 de 3 · Supervisión aprueba 30 de los 45 minutos adicionales.",
				"3 de 3 · La liquidación incluye 30 minutos de hora extra diurna.",
			];

			let step = 0;
			const showStep = () => {
				this.setAttribute("data-started", "");
				scenes.forEach((scene, index) => scene.classList.toggle("is-playing", index === step));
				status.textContent = messages[step];
				this.#timer = window.setTimeout(() => {
					step += 1;
					if (step < scenes.length) {
						showStep();
						return;
					}
					this.#timer = undefined;
					button.textContent = "Volver a reproducir";
				}, 2700);
			};

			button.onclick = () => {
				if (this.#timer !== undefined) {
					window.clearTimeout(this.#timer);
					this.#timer = undefined;
					button.textContent = "Volver a reproducir";
					status.textContent = "Demostración detenida. Las tres pantallas siguen disponibles.";
					this.removeAttribute("data-started");
					scenes.forEach((scene) => scene.classList.remove("is-playing"));
					return;
				}
				step = 0;
				button.textContent = "Detener demostración";
				showStep();
			};
			button.hidden = false;
			status.hidden = false;
		}

		disconnectedCallback() {
			window.clearTimeout(this.#timer);
			this.#timer = undefined;
		}
	}

	customElements.define("inout-playback", InoutPlayback);
</script>

<style>
	.scene.is-playing {
		@apply border-accent ring-2 ring-inset ring-accent/40;
	}

	@media (max-width: 767px) {
		inout-playback[data-started] .scene:not(.is-playing) {
			display: none;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.is-playing .key {
			animation: confirm 650ms ease-out 2 alternate;
		}

		.is-playing .fill {
			animation: approval 1200ms ease-out;
		}

		.is-playing .receipt {
			animation: receipt 700ms ease-out;
		}
	}

	@keyframes confirm {
		to { transform: scale(1.35); }
	}

	@keyframes approval {
		from { transform: scaleX(0); }
	}

	@keyframes receipt {
		from { opacity: 0; transform: translateY(12px); }
	}
</style>
