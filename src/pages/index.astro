---
// Portada (fase 2C) sobre el sistema "Editorial técnico".
// Textos y cifras en src/data/home.ts (null = pendiente).
export const prerender = true;

import SiteLayout from "../layouts/SiteLayout.astro";
import HomeHero from "../components/home/HomeHero.astro";
import ProofStrip from "../components/home/ProofStrip.astro";
import CasesSection from "../components/home/CasesSection.astro";
import ServicesSection from "../components/home/ServicesSection.astro";
import ProcessSection from "../components/home/ProcessSection.astro";
import AboutSection from "../components/home/AboutSection.astro";
import LabSection from "../components/home/LabSection.astro";
import ContactSection from "../components/home/ContactSection.astro";
import { seo } from "../data/home";
import { homeJsonLd } from "../data/seo";
---

<SiteLayout title={seo.title} description={seo.description} isHome jsonLd={homeJsonLd}>
	<HomeHero />
	<ProofStrip />
	<CasesSection />
	<ServicesSection />
	<ProcessSection />
	<AboutSection />
	<LabSection />
	<ContactSection />
</SiteLayout>
