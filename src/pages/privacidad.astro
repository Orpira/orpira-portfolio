---
export const prerender = true;

import SiteLayout from "../layouts/SiteLayout.astro";

// Texto legal migrado de la versión anterior (agosto de 2026). Cambio de octubre de 2026:
// la sección «Datos que se recogen» incluye la analítica sin cookies de Vercel.
const sections = [
	{
		title: "Responsable del tratamiento",
		body: [
			"Orlando Pineda Raad (OrPiRa), Bilbao, España. Puedes contactar conmigo en el formulario de esta web para cualquier consulta sobre tus datos.",
		],
	},
	{
		title: "Datos que se recogen",
		body: [
			"A través del formulario de contacto se recogen únicamente tu nombre, tu correo electrónico y el mensaje que envíes, incluida la opción que marques en «¿Qué necesitas?».",
			"Para saber qué páginas se visitan, esta web usa Vercel Web Analytics. Mide visitas de forma agregada y anónima, sin cookies y sin asociar las visitas a tu dirección IP: cada visitante se cuenta con un identificador temporal que se renueva cada día, de modo que no es posible seguirte entre días distintos ni entre otros sitios web. No se usan cookies de seguimiento ni publicidad.",
		],
	},
	{
		title: "Finalidad y base jurídica",
		body: [
			"Los datos del formulario se utilizan exclusivamente para responder a tu solicitud de contacto y, si procede, gestionar una relación profesional o comercial. La base jurídica es tu consentimiento, que otorgas al marcar la casilla de aceptación antes de enviar el formulario.",
			"La medición agregada de visitas se basa en el interés legítimo de conocer el uso de la web para mejorarla.",
		],
	},
	{
		title: "Conservación",
		body: [
			"Los mensajes se conservan durante un máximo de 24 meses desde el último contacto, o durante el tiempo necesario si existe una relación profesional en curso. Transcurrido ese plazo se eliminan o anonimizan.",
		],
	},
	{
		title: "Destinatarios y encargados",
		body: [
			"Los datos se almacenan en Supabase (infraestructura en la UE) y el sitio, junto con su analítica, se sirve mediante Vercel. Al enviar el formulario puede enviarse una notificación a través de un servicio automatizado de mensajería. Ninguna de estas plataformas recibe tus datos con fines publicitarios ni los cede a terceros.",
		],
	},
	{
		title: "Derechos",
		body: [
			"Puedes ejercer en cualquier momento tus derechos de acceso, rectificación, supresión, oposición, limitación y portabilidad escribiendo a través del formulario de contacto e indicando tu solicitud. También puedes presentar una reclamación ante la Agencia Española de Protección de Datos.",
		],
	},
];
---

<SiteLayout
	title="Política de privacidad · OrPiRa"
	description="Cómo trata OrPiRa los datos del formulario de contacto y la analítica sin cookies de la web."
>
	<article class="pb-24 pt-12 md:pt-20">
		<div class="container-site grid gap-10 md:grid-cols-12">
			<header class="md:col-span-8 md:col-start-4">
				<p class="t-data text-ink-muted">Legal · Última actualización: octubre de 2026</p>
				<h1 class="t-h2 mt-5">Política de privacidad</h1>
			</header>
			<div class="md:col-span-7 md:col-start-4">
				{
					sections.map((section) => (
						<section class="border-t border-line py-8">
							<h2 class="t-h3">{section.title}</h2>
							<div class="mt-3 space-y-4">
								{section.body.map((p) => <p>{p}</p>)}
							</div>
						</section>
					))
				}
			</div>
		</div>
	</article>
</SiteLayout>
