---
import { supabaseAdmin } from "../../lib/supabase-admin";
import CRMLayout from "../../layouts/CRMLayout.astro";
import {
  ADMIN_SESSION_COOKIE,
  verifyAdminSession,
} from "../../lib/admin-session";

if (
  !verifyAdminSession(
    Astro.cookies.get(ADMIN_SESSION_COOKIE)?.value
  )
) {
  return Astro.redirect("/dashboard", 303);
}

const leadDateFormat = new Intl.DateTimeFormat("es-ES", {
  timeZone: "Europe/Madrid",
});

const { data: leads, error } = await supabaseAdmin
  .from("contacts")
  .select("id, name, email, lead_type, priority, lead_score, created_at")
  .order("lead_score", { ascending: false });

if (error) {
  console.error(
    JSON.stringify({
      scope: "leads-query",
      code: error.code ?? "unknown",
    })
  );
}

---

<CRMLayout title="Leads | CRM OrPiRa">


    <div class="max-w-7xl mx-auto p-6">  
        
        <div class="mb-8">

        <h1 class="text-black text-4xl font-bold">
            Leads
        </h1>

        <p class="text-black mt-2">
            Seguimiento y clasificación automática
        </p>

        </div>

        <!-- Buscador -->

        <div class="mb-6">

        <input
            type="search"
            id="lead-search"
            aria-label="Buscar por nombre, correo o fecha"
            placeholder="Buscar lead..."
            class="w-full bg-slate-900 border border-slate-800 rounded-lg px-4 py-3"
        />

        </div>

        <!-- Tabla -->

        <div class="bg-slate-900 rounded-xl border border-slate-800 overflow-hidden">

        <div class="overflow-x-auto">

            <table class="w-full">

            <thead class="bg-slate-800">

                <tr>

                <th class="text-left p-4">
                    Nombre
                </th>

                <th class="text-left p-4">
                    Email
                </th>

                <th class="text-left p-4">
                    Tipo
                </th>

                <th class="text-left p-4">
                    Prioridad
                </th>

                <th class="text-left p-4">
                    Score
                </th>

                <th class="text-left p-4">
                    Fecha
                </th>

                </tr>

            </thead>

            <tbody>

                {
                leads?.map((lead) => (

                    <tr data-lead-row class="border-t border-slate-800">

                    <td class="p-4">
                        <a
                            href={`/dashboard/lead/${lead.id}`}
                            class="text-cyan-400 hover:underline"
                        >
                            {lead.name}
                        </a>
                    </td>

                    <td class="p-4">
                        {lead.email}
                    </td>

                    <td class="p-4">

                        <span class="px-3 py-1 rounded-full bg-blue-500/20 text-blue-300 text-sm">

                        {lead.lead_type}

                        </span>

                    </td>

                    <td class="p-4">
                        <span
                            class={
                                lead.priority === "alta"
                                ? "px-3 py-1 rounded-full bg-red-500/20 text-red-400"
                                : lead.priority === "media"
                                ? "px-3 py-1 rounded-full bg-yellow-500/20 text-yellow-400"
                                : "px-3 py-1 rounded-full bg-green-500/20 text-green-400"
                            }
                            >
                            {lead.priority}
                        </span>                      
                    </td>

                    <td class="p-4">
                        <span
                            class={
                            lead.lead_score >= 80
                                ? "text-green-400 font-bold"
                                : lead.lead_score >= 50
                                ? "text-yellow-400 font-bold"
                                : "text-slate-400 font-bold"
                            }
                        >
                            {lead.lead_score}
                        </span>
                    </td>

                    <td class="p-4">

                        {
                        leadDateFormat.format(new Date(lead.created_at))
                        }

                    </td>

                    </tr>

                ))
                }

            </tbody>

            </table>

        </div>

        </div>
        <p id="lead-search-empty" hidden class="mt-4 text-slate-800" role="status">No se encontraron leads.</p>
    </div>
</CRMLayout>

<script>
  const search = document.querySelector<HTMLInputElement>("#lead-search");
  const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>("[data-lead-row]"));
  const empty = document.querySelector<HTMLElement>("#lead-search-empty");
  const normalize = (text: string) => text.toLocaleLowerCase("es-ES").normalize("NFD").replace(/\p{M}/gu, "");

  search?.addEventListener("input", () => {
    const query = normalize(search.value.trim());
    for (const row of rows) row.hidden = !normalize(row.textContent ?? "").includes(query);
    if (empty) empty.hidden = !query || rows.some((row) => !row.hidden);
  });
</script>
