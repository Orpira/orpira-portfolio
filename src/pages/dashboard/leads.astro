---
import { supabaseAdmin } from "../../lib/supabase-admin";
import CRMLayout from "../../layouts/CRMLayout.astro";
import {
  ADMIN_SESSION_COOKIE,
  verifyAdminSession,
} from "../../lib/admin-session";

if (
  !verifyAdminSession(
    Astro.cookies.get(ADMIN_SESSION_COOKIE)?.value
  )
) {
  return Astro.redirect("/dashboard", 303);
}

const leadDateFormat = new Intl.DateTimeFormat("es-ES", {
  timeZone: "Europe/Madrid",
  dateStyle: "short",
  timeStyle: "short",
});

const byScore = Astro.url.searchParams.get("orden") === "puntuacion";
const { data: leads, error } = await supabaseAdmin
  .from("contacts")
  .select("id, name, email, lead_type, priority, lead_score, created_at, commercial_replies(status, manual_requested_at)")
  .order(byScore ? "lead_score" : "created_at", { ascending: false, nullsFirst: false })
  .order("id");

if (error) {
  console.error(
    JSON.stringify({
      scope: "leads-query",
      code: error.code ?? "unknown",
    })
  );
}

const replyStatusLabels: Record<string, string> = {
  draft: "Borrador", sending: "En proceso", sent: "Enviado",
  failed: "Fallido", unknown: "Por confirmar",
};
const statusFor = (related: { status: string; manual_requested_at: string | null }[] | { status: string; manual_requested_at: string | null } | null) => {
  const reply = Array.isArray(related) ? related[0] : related;
  if (!reply) return "Sin respuesta";
  if (reply.status === "draft" && reply.manual_requested_at) return "En cola";
  return replyStatusLabels[reply.status] ?? reply.status;
};

---

<CRMLayout title="Leads | CRM OrPiRa">


    <div class="max-w-7xl mx-auto">
        
        <div class="mb-8 flex flex-wrap items-start justify-between gap-3"><div>

        <h1 class="text-black text-4xl font-bold">
            Leads
        </h1>

        <p class="text-black mt-2">
            Seguimiento y clasificación automática
        </p>

        </div>
        <a href="/dashboard/embudo" class="rounded-lg border border-slate-300 bg-white px-4 py-2 font-semibold text-teal-800 hover:bg-teal-50">Ver embudo</a>
        </div>

        <!-- Buscador -->

        <div class="mb-6 grid gap-3 sm:grid-cols-[1fr_auto]">
        <form action="/dashboard/leads" method="get" class="flex flex-wrap gap-2 sm:order-2">
          <label class="sr-only" for="orden">Orden</label>
          <select id="orden" name="orden" class="rounded-lg border-slate-300 bg-white text-slate-900">
            <option value="fecha" selected={!byScore}>Más recientes</option>
            <option value="puntuacion" selected={byScore}>Mayor puntuación</option>
          </select>
          <button class="rounded-lg bg-slate-900 px-3 font-semibold text-white">Ordenar</button>
        </form>

        <input
            type="search"
            id="lead-search"
            aria-label="Buscar por nombre, correo o fecha"
            placeholder="Buscar lead..."
            class="w-full bg-slate-900 border border-slate-800 rounded-lg px-4 py-3"
        />

        </div>

        {error && <p class="mb-3 text-sm text-amber-800">No se pudieron cargar los leads.</p>}
        {!error && !leads?.length && <p class="mb-3 text-sm text-slate-700">Todavía no hay leads registrados.</p>}

        {Astro.url.searchParams.get("eliminar") === "deleted" && (
          <p role="status" class="mb-4 rounded-lg bg-teal-50 p-3 text-teal-900">Prospecto eliminado.</p>
        )}
        {Astro.url.searchParams.get("eliminar") === "missing" && (
          <p role="status" class="mb-4 rounded-lg bg-slate-200 p-3 text-slate-900">El prospecto ya no está en el CRM.</p>
        )}

        <!-- Tabla -->

        <div class="bg-slate-900 rounded-xl border border-slate-800 overflow-hidden">

        <div class="overflow-x-auto">

            <table class="crm-data-table" role="table">

            <thead role="rowgroup" class="bg-slate-800">

                <tr role="row">

                <th scope="col" role="columnheader" class="text-left p-4">
                    Nombre
                </th>

                <th scope="col" role="columnheader" class="text-left p-4">
                    Email
                </th>

                <th scope="col" role="columnheader" class="text-left p-4">
                    Tipo
                </th>

                <th scope="col" role="columnheader" class="text-left p-4">
                    Prioridad
                </th>

                <th scope="col" role="columnheader" class="text-left p-4">
                    Score
                </th>

                <th scope="col" role="columnheader" class="text-left p-4">Correo</th>
                <th scope="col" role="columnheader" class="text-left p-4">
                    Fecha
                </th>

                </tr>

            </thead>

            <tbody role="rowgroup">

                {
                leads?.map((lead) => (

                    <tr role="row" data-lead-row class="border-t border-slate-800">

                    <td role="cell" class="p-4">
                        <a
                            href={`/dashboard/lead/${lead.id}`}
                            class="text-cyan-400 hover:underline"
                        >
                            {lead.name}
                        </a>
                    </td>

                    <td role="cell" class="p-4">
                        {lead.email}
                    </td>

                    <td role="cell" class="p-4"><span class="crm-cell-label" aria-hidden="true">Tipo</span>

                        <span class="px-3 py-1 rounded-full bg-blue-500/20 text-blue-300 text-sm">

                        {lead.lead_type}

                        </span>

                    </td>

                    <td role="cell" class="p-4"><span class="crm-cell-label" aria-hidden="true">Prioridad</span>
                        <span
                            class={
                                lead.priority === "alta"
                                ? "px-3 py-1 rounded-full bg-red-500/20 text-red-400"
                                : lead.priority === "media"
                                ? "px-3 py-1 rounded-full bg-yellow-500/20 text-yellow-400"
                                : "px-3 py-1 rounded-full bg-green-500/20 text-green-400"
                            }
                            >
                            {lead.priority}
                        </span>                      
                    </td>

                    <td role="cell" class="p-4"><span class="crm-cell-label" aria-hidden="true">Score</span>
                        <span
                            class={
                            lead.lead_score >= 80
                                ? "text-green-400 font-bold"
                                : lead.lead_score >= 50
                                ? "text-yellow-400 font-bold"
                                : "text-slate-400 font-bold"
                            }
                        >
                            {lead.lead_score}
                        </span>
                    </td>

                    <td role="cell" class="p-4"><span class="crm-cell-label" aria-hidden="true">Correo</span>
                        {statusFor(lead.commercial_replies)}
                    </td>

                    <td role="cell" class="p-4"><span class="crm-cell-label" aria-hidden="true">Fecha</span>

                        {leadDateFormat.format(new Date(lead.created_at))}

                    </td>

                    </tr>

                ))
                }

            </tbody>

            </table>

        </div>

        </div>
        <p id="lead-search-empty" hidden class="mt-4 text-slate-800" role="status">No se encontraron leads.</p>
    </div>
</CRMLayout>

<script>
  const search = document.querySelector<HTMLInputElement>("#lead-search");
  const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>("[data-lead-row]"));
  const empty = document.querySelector<HTMLElement>("#lead-search-empty");
  const normalize = (text: string) => text.toLocaleLowerCase("es-ES").normalize("NFD").replace(/\p{M}/gu, "");

  search?.addEventListener("input", () => {
    const query = normalize(search.value.trim());
    for (const row of rows) row.hidden = !normalize(row.textContent ?? "").includes(query);
    if (empty) empty.hidden = !query || rows.some((row) => !row.hidden);
  });
</script>
