---
import CRMLayout from "../../layouts/CRMLayout.astro";
import { supabaseAdmin } from "../../lib/supabase-admin";
import {
  ADMIN_SESSION_COOKIE,
  verifyAdminSession,
} from "../../lib/admin-session";

if (
  !verifyAdminSession(
    Astro.cookies.get(ADMIN_SESSION_COOKIE)?.value
  )
) {
  return Astro.redirect("/dashboard", 303);
}

const { data: clientes } = await supabaseAdmin
  .from("contacts")
  .select("id, name, email, priority, lead_score")
  .eq("lead_type", "cliente")
  .order("lead_score", {
    ascending: false,
  });
---

<CRMLayout title="Clientes">

<div>

  <div class="mb-8">

    <h1 class="text-3xl font-bold text-slate-950 sm:text-4xl">
      Clientes
    </h1>

    <p class="mt-2 text-slate-600">
      Clientes potenciales clasificados automáticamente
    </p>

  </div>

  <div
    class="bg-slate-900 rounded-xl border border-slate-800 overflow-hidden"
  >
    <div class="mb-3">
        <div class="bg-slate-900 p-6 rounded-xl">
            <p class="text-slate-400">
                Total Clientes
            </p>
            <h2 class="text-4xl font-bold">
                {clientes?.length ?? 0}
            </h2>
        </div>
    </div>

    <table class="crm-data-table" role="table">

      <thead role="rowgroup" class="bg-slate-800">

        <tr role="row">

          <th scope="col" role="columnheader" class="text-left p-4">
            Nombre
          </th>

          <th scope="col" role="columnheader" class="text-left p-4">
            Email
          </th>

          <th scope="col" role="columnheader" class="text-left p-4">
            Prioridad
          </th>

          <th scope="col" role="columnheader" class="text-left p-4">
            Score
          </th>

        </tr>

      </thead>

      <tbody role="rowgroup">

        {
          clientes?.map(cliente => (

            <tr role="row" class="border-t border-slate-800">

              <td role="cell" class="p-4">
                <a class="text-cyan-400 hover:underline" href={`/dashboard/lead/${cliente.id}`}>{cliente.name}</a>
              </td>

              <td role="cell" class="p-4">
                {cliente.email}
              </td>

              <td role="cell" class="p-4"><span class="crm-cell-label" aria-hidden="true">Prioridad</span>
                {cliente.priority}
              </td>

              <td role="cell" class="p-4"><span class="crm-cell-label" aria-hidden="true">Score</span>
                {cliente.lead_score}
              </td>

            </tr>

          ))
        }

      </tbody>

    </table>

  </div>

</div>

</CRMLayout>