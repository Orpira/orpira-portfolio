---
import { stages, stageLabel, stageFeedback } from "../../../lib/crm-pipeline";
import { categories } from "../../../lib/crm-categories";
import CRMLayout from "../../../layouts/CRMLayout.astro";
import CrmConfirmation from "../../../components/ui/CrmConfirmation.astro";
import { supabaseAdmin } from "../../../lib/supabase-admin";
import {
  ADMIN_SESSION_COOKIE,
  verifyAdminSession,
} from "../../../lib/admin-session";

if (
  !verifyAdminSession(
    Astro.cookies.get(ADMIN_SESSION_COOKIE)?.value
  )
) {
  return Astro.redirect("/dashboard", 303);
}

const { id } = Astro.params;

const { data: lead } = await supabaseAdmin
  .from("contacts")
  .select("id, name, email, status, lead_type, priority, lead_score, message, created_at, contact_category, company, social_profile, source, source_page, last_contacted_at, next_follow_up_on, next_follow_up_action")
  .eq("id", id)
  .single();

if (!lead) {
  return Astro.redirect("/dashboard/leads");
}

const [{ data: replies, error: repliesError }, { data: notes, error: notesError }, { data: changes, error: changesError }, { data: bookings, error: bookingsError }, { data: followUpHistory, error: followUpHistoryError }, { data: bookingSettings }] = await Promise.all([
  supabaseAdmin.from("commercial_replies")
    .select("id, subject, body, status, created_at, sent_at, smtp_message_id, approved_recipient, manual_requested_at, send_started_at, send_finished_at")
    .eq("contact_id", lead.id).order("created_at", { ascending: false }),
  supabaseAdmin.from("crm_contact_notes")
    .select("id, body, created_at").eq("contact_id", lead.id)
    .order("created_at", { ascending: false }).order("id"),
  supabaseAdmin.from("crm_contact_stage_changes")
    .select("id, from_stage, to_stage, changed_at").eq("contact_id", lead.id)
    .order("changed_at", { ascending: false }).order("id"),
  supabaseAdmin.from("crm_bookings").select("uid,start_at,meeting_url,created_at,revision,revised_at").eq("contact_id", lead.id)
    .order("start_at", { ascending: false }),
  supabaseAdmin.from("crm_follow_up_completions").select("id,action,completed_at").eq("contact_id", lead.id)
    .order("completed_at", { ascending: false }),
  supabaseAdmin.from("crm_booking_settings").select("booking_url").eq("singleton", true).maybeSingle(),
]);

const draft = replies?.find((reply) => reply.status === "draft");
const queued = Boolean(draft?.manual_requested_at);
const showEditor = !repliesError && (!replies?.length || Boolean(draft && !draft.approved_recipient));
const validRecipient = /^[a-z0-9_.+%\-]+@[a-z0-9.-]+\.[a-z]{2,}$/i.test(lead.email) &&
  !/@([a-z0-9-]+\.)*(example\.(com|net|org)|[^@]+\.(test|invalid|localhost))$/i.test(lead.email);

const configuredBookingUrl = bookingSettings?.booking_url;
const bookingUrl = validRecipient && configuredBookingUrl &&
  /^https:\/\/(app\.)?cal\.com\/[\w-]+\/[\w-]+$/.test(configuredBookingUrl)
  ? new URL(configuredBookingUrl)
  : null;
bookingUrl?.searchParams.set("name", lead.name);
bookingUrl?.searchParams.set("email", lead.email);
const embeddedBookingUrl = bookingUrl ? new URL(bookingUrl) : null;
embeddedBookingUrl?.searchParams.set("embed", "true");
embeddedBookingUrl?.searchParams.set("embedType", "inline");

const replyMessages: Record<string, string> = {
  saved: "Borrador guardado.",
  requested: "Correo en cola. n8n revisa los envíos cada cinco minutos.",
  invalid: "Revisá el asunto, el mensaje y el destinatario.",
  conflict: "La respuesta cambió o ya está en cola. Revisá el historial antes de continuar.",
  error: "No se pudo guardar la respuesta.",
};
const feedback = replyMessages[Astro.url.searchParams.get("reply") ?? ""];
const noteMessages: Record<string, string> = {
  saved: "Nota guardada.",
  invalid: "La nota debe tener entre 1 y 4000 caracteres.",
  error: "No se pudo guardar la nota.",
};
const deleteMessages: Record<string, string> = {
  confirm: "Confirmá que querés eliminar el prospecto.",
  won: "El contacto ya aceptó la propuesta y está protegido.",
  sending: "Hay un correo en envío. Esperá a que termine antes de eliminar el prospecto.",
  error: "No se pudo eliminar el prospecto.",
};
const deleteFeedback = deleteMessages[Astro.url.searchParams.get("eliminar") ?? ""];
const noteFeedback = noteMessages[Astro.url.searchParams.get("nota") ?? ""];
const replyStatuses: Record<string, string> = {
  draft: "Borrador",
  sending: "Envío en curso",
  sent: "Enviado",
  failed: "Envío fallido",
  unknown: "Resultado sin confirmar",
};
const currentStage = stages.findIndex((stage) => stage.id === lead.status);
const stageResult = Astro.url.searchParams.get("etapa");
const stageNotice = stageFeedback[stageResult ?? ""];
const dateFormat = new Intl.DateTimeFormat("es-ES", {
  dateStyle: "medium",
  timeStyle: "short",
  timeZone: "Europe/Madrid",
});
const formatDate = (date: string) => dateFormat.format(new Date(date));
const fields = [
  { label: "Estado comercial", value: stageLabel(lead.status) },
  { label: "Tipo de consulta", value: lead.lead_type?.replaceAll("_", " ") },
  { label: "Prioridad", value: lead.priority },
  { label: "Puntuación", value: lead.lead_score },
];
type Activity = { label: string; date: string; detail?: string; url?: string; meetingAt?: string; reply?: NonNullable<typeof replies>[number] };
const activity: Activity[] = [
  { label: "Contacto recibido", date: lead.created_at },
  ...(lead.last_contacted_at ? [{ label: "Contacto registrado", date: lead.last_contacted_at }] : []),
  ...(bookings ?? []).filter((booking) => booking.revision !== "superseded").map((booking) => ({
    label: booking.revision === "cancelled" ? "Reserva cancelada" :
      booking.revision === "rescheduled" ? "Reserva reprogramada" : "Reunión agendada",
    date: booking.revised_at ?? booking.created_at,
    meetingAt: booking.start_at,
    url: booking.revision === "cancelled" ? null : booking.meeting_url,
  })),
  ...(followUpHistory ?? []).map((task) => ({ label: "Seguimiento completado", detail: task.action, date: task.completed_at })),
  ...(changes ?? []).map((change) => ({ label: `${stageLabel(change.from_stage)} → ${stageLabel(change.to_stage)}`, date: change.changed_at })),
  ...(notes ?? []).map((note) => ({ label: "Nota interna", detail: note.body, date: note.created_at })),
  ...(replies ?? []).map((reply) => ({
    label: reply.status === "draft" && reply.manual_requested_at ? "Correo en cola" : replyStatuses[reply.status] ?? reply.status,
    date: reply.sent_at ?? reply.send_finished_at ?? reply.send_started_at ?? reply.manual_requested_at ?? reply.created_at, reply,
  })),
];
activity.sort((a, b) => Date.parse(b.date) - Date.parse(a.date));

---

<CRMLayout title={`${lead.name} | CRM OrPiRa`}>
  <div class="mx-auto max-w-7xl space-y-6 text-slate-900">
    <header class="flex flex-wrap items-end justify-between gap-3">
      <div class="min-w-0">
        <a href="/dashboard/leads" class="text-sm font-semibold text-teal-800 hover:underline">← Volver a Leads</a>
        <h1 class="mt-3 break-words text-3xl font-bold tracking-tight sm:text-4xl">{lead.name}</h1>
        <p class="mt-1 break-all text-slate-600">{lead.email}</p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <time class="text-sm text-slate-600" datetime={lead.created_at}>Recibido el {formatDate(lead.created_at)}</time>
        {bookingUrl && embeddedBookingUrl && (
          <a id="lead-booking-open" href={bookingUrl.href} target="_blank" rel="noopener noreferrer"
            class="rounded-lg bg-teal-700 px-4 py-3 text-sm font-semibold text-white hover:bg-teal-800">
            Agendar reunión
          </a>
        )}
      </div>
    </header>

    {bookingUrl && embeddedBookingUrl && (
      <dialog id="lead-booking" aria-labelledby="lead-booking-title"
        class="m-auto w-[min(96vw,64rem)] max-w-none rounded-xl border border-slate-300 bg-white p-0 text-slate-900 shadow-xl backdrop:bg-slate-950/60">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 p-4">
          <h2 id="lead-booking-title" class="font-semibold">Agendar reunión</h2>
          <form method="dialog" class="flex flex-wrap items-center gap-3">
            <a href={bookingUrl.href} target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-teal-800 underline">Abrir en Cal.com</a>
            <button class="min-h-11 rounded-lg border border-slate-300 px-3 text-sm font-semibold">Cerrar</button>
          </form>
        </div>
        <iframe id="lead-booking-frame" title="Calendario de reservas de Cal.com" data-src={embeddedBookingUrl.href}
          referrerpolicy="no-referrer" class="block h-[min(66dvh,42rem)] w-full border-0"></iframe>
        <div class="flex flex-wrap items-center justify-between gap-2 border-t border-slate-200 p-4 text-sm">
          <p class="text-slate-600">Después de confirmar la cita, actualizá la ficha para verla en Actividad.</p>
          <a id="lead-booking-refresh" href={`/dashboard/lead/${lead.id}#activity-title`} class="font-semibold text-teal-800 underline">Actualizar ficha</a>
        </div>
      </dialog>
    )}

    <section class="space-y-3 rounded-xl border border-slate-200 bg-white p-4" aria-labelledby="stage-title">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 id="stage-title" class="font-semibold"><a href="/dashboard/embudo" class="text-teal-800 hover:underline">Embudo comercial</a></h2>
        <form method="post" action={`/dashboard/lead/${lead.id}/etapa`} class="flex w-full flex-wrap gap-2 sm:w-auto">
          <input type="hidden" name="from" value={lead.status ?? ""} />
          <input type="hidden" name="return" value="lead" />
          <select name="to" required aria-label="Cambiar etapa" class="rounded-lg border-slate-300 bg-white text-sm">
            <option value="">Mover a…</option>
            {stages.filter((stage) => stage.id !== lead.status).map((stage) => <option value={stage.id}>{stage.label}</option>)}
          </select>
          <button class="rounded-lg bg-teal-700 px-3 py-2 text-sm font-semibold text-white hover:bg-teal-800">Cambiar etapa</button>
        </form>
      </div>
      <ol class="grid grid-cols-2 gap-2 text-sm sm:grid-cols-3 xl:grid-cols-6">
        {stages.map((stage, index) => (
          <li aria-current={index === currentStage ? "step" : undefined}
            class:list={["rounded-lg px-3 py-2", index === currentStage ? "bg-teal-800 font-semibold text-white" : "bg-slate-100 text-slate-700"]}>
            {stage.label}
          </li>
        ))}
      </ol>
      {stageNotice && (
        <div class="rounded-lg bg-teal-50 p-3 text-sm text-teal-900">
          <p role="status">{stageResult === "saved" ? `Contacto movido a «${stageLabel(lead.status)}».` : stageNotice}</p>
          {stageResult === "saved" && (
            <a href={`/dashboard/embudo#contacto-${lead.id}`} class="mt-1 inline-block font-semibold underline">
              Ver contacto en el embudo
            </a>
          )}
        </div>
      )}
    </section>

    <dl class="grid grid-cols-2 gap-3 lg:grid-cols-4">
      {fields.map(({ label, value }) => (
        <div class="rounded-xl border border-slate-200 bg-white p-4">
          <dt class="text-sm text-slate-600">{label}</dt>
          <dd class="mt-1 break-words font-semibold capitalize">{value ?? "Sin asignar"}</dd>
        </div>
      ))}
    </dl>

    <section id="seguimiento" class="rounded-xl border border-slate-200 bg-white p-5">
      <h2 class="text-lg font-semibold">Seguimiento</h2>
      <p class="mt-2 text-sm text-slate-600">
        {lead.company && <span>Empresa {lead.company} · </span>}
        {lead.social_profile && <span class="break-all">Perfil {lead.social_profile} · </span>}
        Origen {lead.source ?? "Sin especificar"}{lead.source_page && ` · ${lead.source_page}`}
      </p>
      <p class="mt-2 text-sm text-slate-600">
        Último contacto {lead.last_contacted_at || replies?.some((reply) => reply.sent_at)
          ? formatDate([lead.last_contacted_at, ...(replies ?? []).map((reply) => reply.sent_at)]
              .filter(Boolean).sort((a, b) => Date.parse(b) - Date.parse(a))[0])
          : "Sin registrar"}
      </p>
      {Astro.url.searchParams.has("seguimiento") && (
        <p role="status" class="mt-2 text-sm text-teal-900">
          {Astro.url.searchParams.get("seguimiento") === "completed" ? "Seguimiento marcado como hecho." :
            Astro.url.searchParams.get("seguimiento") === "saved" ? "Seguimiento guardado." : "No se pudo guardar el seguimiento."}
        </p>
      )}
      <form method="post" action={`/dashboard/lead/${lead.id}/seguimiento`} class="mt-4 grid gap-3 sm:flex sm:flex-wrap sm:items-end">
        <label class="grid min-w-0 gap-1 text-sm font-medium">
          Categoría
          <select name="category" class="rounded-lg border-slate-300 bg-white">
            <option value="">Sin categorizar</option>
            {Object.entries(categories).map(([key, label]) => <option value={key} selected={lead.contact_category === key}>{label}</option>)}
          </select>
        </label>
        <label class="grid min-w-0 gap-1 text-sm font-medium">
          Próximo seguimiento
          <input type="date" name="date" value={lead.next_follow_up_on} class="rounded-lg border-slate-300 bg-white" />
        </label>
        <label class="grid min-w-0 gap-1 text-sm font-medium">
          Próxima acción
          <input name="nextAction" maxlength="160" value={lead.next_follow_up_action}
            placeholder="Ej. Preparar propuesta" class="rounded-lg border-slate-300 bg-white" />
        </label>
        <button name="action" value="save" class="rounded-lg bg-teal-700 px-3 py-2 text-sm font-semibold text-white">Guardar seguimiento</button>
        <button name="action" value="contacted" class="rounded-lg border border-slate-300 px-3 py-2 text-sm font-semibold">Registrar contacto de hoy</button>
      </form>
      {lead.next_follow_up_on && (
        <form method="post" action={`/dashboard/lead/${lead.id}/seguimiento`} class="mt-3">
          <input type="hidden" name="date" value={lead.next_follow_up_on} />
          <input type="hidden" name="nextAction" value={lead.next_follow_up_action ?? ""} />
          <button name="action" value="complete" class="rounded-lg border border-teal-700 px-3 py-2 text-sm font-semibold text-teal-800">Marcar como hecha</button>
        </form>
      )}
    </section>

    <div class="grid gap-6 lg:grid-cols-2">
      <section class="min-w-0 self-start rounded-xl border border-slate-200 bg-white p-5" aria-labelledby="original-title">
        <h2 id="original-title" class="text-lg font-semibold">Mensaje recibido</h2>
        <p class="mt-3 whitespace-pre-wrap break-words text-slate-700">{lead.message}</p>
      </section>

      <section id="respuesta" class="min-w-0 rounded-xl border border-slate-200 bg-white p-5" aria-labelledby="reply-title">
        <h2 id="reply-title" class="text-lg font-semibold">Responder al lead</h2>
        {feedback && <p role="status" class="mt-3 rounded-lg bg-teal-50 p-3 text-sm text-teal-900">{feedback}</p>}
        {showEditor ? (
          <form id="crm-reply-form" method="post" action={`/dashboard/lead/${lead.id}/reply`} class="mt-4 space-y-4">
            {draft && <input type="hidden" name="replyId" value={draft.id} />}
            <input type="hidden" name="recipient" value={lead.email} />
            <p class="break-all text-sm text-slate-600">Para {lead.email}</p>
            <label class="block text-sm font-medium">
              Plantilla de respuesta
              <select id="reply-template" class="mt-1 w-full rounded-lg border-slate-300 bg-white" data-first-name={lead.name.trim().split(/\s+/)[0]}>
                <option value="">Elegir plantilla…</option>
                <option value="project">Proyecto</option>
                <option value="job">Oferta laboral</option>
                <option value="network">Networking</option>
              </select>
            </label>
            <label class="grid min-w-0 gap-1 text-sm font-medium">
              Asunto
              <input name="subject" maxlength="200" required value={draft?.subject ?? "Re: Consulta a OrPiRa"}
                class="w-full rounded-lg border-slate-300 bg-white text-slate-900" />
            </label>
            <label class="grid min-w-0 gap-1 text-sm font-medium">
              Mensaje
              <textarea name="body" maxlength="10000" rows="8" required
                class="w-full rounded-lg border-slate-300 bg-white text-slate-900">{draft?.body ?? ""}</textarea>
            </label>
            <div class="flex flex-wrap gap-3">
              <button name="action" value="save" class="rounded-lg border border-slate-300 px-4 py-2 font-semibold hover:bg-slate-100">
                Guardar borrador
              </button>
              {validRecipient && (
                <button name="action" value="send" class="rounded-lg bg-teal-700 px-4 py-2 font-semibold text-white hover:bg-teal-800">
                  Enviar correo
                </button>
              )}
            </div>
            {!validRecipient && <p class="text-sm text-amber-800">El correo del contacto no admite envío.</p>}
          </form>
        ) : (
          <p class="mt-3 text-sm text-slate-600">
            {repliesError ? "El editor no está disponible en este momento." :
              queued ? "El correo está en cola. Consultá el resultado en la actividad." :
              "Consultá el estado de la respuesta en la actividad del contacto."}
          </p>
        )}
      </section>
    </div>

    <section class="rounded-xl border border-slate-200 bg-white p-5" aria-labelledby="activity-title">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 id="activity-title" class="text-lg font-semibold">Actividad del contacto</h2>
        {(queued || replies?.some((reply) => reply.status === "sending")) && (
          <a id="lead-booking-refresh" href={`/dashboard/lead/${lead.id}#activity-title`} class="text-sm font-semibold text-teal-800 hover:underline">Actualizar estado</a>
        )}
      </div>
      <ol class="mt-4 space-y-4 border-l-2 border-slate-200 pl-4">
        {activity.map(({ label, date, detail, url, meetingAt, reply }) => (
          <li class="space-y-2">
            <div class="flex flex-wrap items-baseline justify-between gap-x-3">
              <p class="font-semibold">{label}{reply && ` · ${reply.subject}`}</p>
              <time class="text-sm text-slate-600" datetime={date}>{formatDate(date)}</time>
            </div>
            {detail && <p class="whitespace-pre-wrap break-words text-sm text-slate-700">{detail}</p>}
            {meetingAt && <p class="text-sm text-slate-700">Cita el <time datetime={meetingAt}>{formatDate(meetingAt)}</time></p>}
            {url && <a href={url} class="text-sm font-semibold text-teal-800 hover:underline" rel="noreferrer">Abrir reunión</a>}
            {reply && (
              <details>
                <summary class="cursor-pointer text-sm font-semibold text-teal-800">Ver correo y detalles de envío</summary>
                <dl class="mt-2 space-y-1 text-sm">
                  {[
                    { label: "Borrador creado", at: reply.created_at },
                    { label: "Envío manual solicitado", at: reply.manual_requested_at },
                    { label: "Envío iniciado", at: reply.send_started_at },
                    { label: reply.sent_at ? "Aceptado por SMTP" : "Resultado registrado", at: reply.sent_at ?? reply.send_finished_at },
                  ].filter(({ at }) => at).map(({ label, at }) => (
                    <div class="flex flex-wrap gap-x-2">
                      <dt class="font-medium">{label}</dt>
                      <dd class="text-slate-600"><time datetime={at}>{formatDate(at)}</time></dd>
                    </div>
                  ))}
                  {reply.smtp_message_id && (
                    <div><dt class="font-medium">Identificador SMTP</dt><dd class="break-all text-slate-600">{reply.smtp_message_id}</dd></div>
                  )}
                </dl>
                <p class="mt-2 whitespace-pre-wrap break-words text-slate-700">{reply.body}</p>
              </details>
            )}
          </li>
        ))}
      </ol>
      {(changesError || bookingsError || followUpHistoryError) && <p class="mt-3 text-sm text-amber-800">No se pudo cargar parte de la actividad.</p>}
      {repliesError && <p class="mt-3 text-sm text-amber-800">No se pudo cargar el historial de respuestas.</p>}
    </section>
    <section id="notas" class="rounded-xl border border-slate-200 bg-white p-5" aria-labelledby="notes-title">
      <h2 id="notes-title" class="text-lg font-semibold">Notas internas</h2>
      {noteFeedback && <p role="status" class="mt-3 text-sm text-slate-700">{noteFeedback}</p>}
      {notesError ? (
        <p class="mt-3 text-sm text-amber-800">No se pudieron cargar las notas.</p>
      ) : (
        <>
          <form method="post" action={`/dashboard/lead/${lead.id}/nota`} class="mt-4 space-y-3">
            <label class="grid min-w-0 gap-1 text-sm font-medium">
              Añadir nota de seguimiento
              <textarea name="body" rows="3" maxlength="4000" required
                class="rounded-lg border-slate-300 bg-white text-slate-900" />
            </label>
            <button class="rounded-lg border border-slate-300 px-4 py-2 font-semibold hover:bg-slate-100">
              Guardar nota
            </button>
          </form>
        </>
      )}
    </section>

    {(lead.status !== "won" || deleteFeedback) && (
      <section id="eliminar-prospecto" class="rounded-xl border border-rose-200 bg-white p-5" aria-label="Eliminar prospecto">
        {deleteFeedback && <p role="status" class="mb-2 text-sm text-rose-800">{deleteFeedback}</p>}
        {lead.status !== "won" && (
          <details open={Boolean(deleteFeedback)}>
            <summary class="cursor-pointer font-semibold text-rose-800">Eliminar prospecto</summary>
            <p class="mt-3 text-sm text-slate-700">
              Se eliminarán definitivamente la ficha de {lead.name}, sus notas, seguimientos y el historial del CRM.
              Las citas externas y los correos ya enviados seguirán en sus servicios.
            </p>
            <form method="post" action={`/dashboard/lead/${lead.id}/eliminar`} class="mt-3 grid justify-items-start gap-3">
              <label class="flex items-center gap-2 text-sm">
                <input type="checkbox" name="confirm" value={lead.id} required class="size-5 min-h-0 rounded border-slate-400" />
                Confirmo que quiero eliminar este prospecto
              </label>
              <button class="rounded-lg bg-rose-700 px-4 py-2 font-semibold text-white hover:bg-rose-800">
                Eliminar definitivamente
              </button>
            </form>
          </details>
        )}
      </section>
    )}
    {showEditor && <CrmConfirmation id="crm-reply-confirmation" />}
  </div>
</CRMLayout>

<script>
  import { confirmCrmAction } from "../../../lib/crm-confirmation";

  const bookingLink = document.querySelector<HTMLAnchorElement>("#lead-booking-open");
  const bookingDialog = document.querySelector<HTMLDialogElement>("#lead-booking");
  const bookingFrame = document.querySelector<HTMLIFrameElement>("#lead-booking-frame");
  bookingLink?.addEventListener("click", (event) => {
    if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
    if (!bookingDialog?.showModal || !bookingFrame?.dataset.src) return;

    event.preventDefault();
    if (!bookingFrame.hasAttribute("src")) bookingFrame.src = bookingFrame.dataset.src;
    bookingDialog.showModal();
  });


  const bookingRefresh = document.querySelector<HTMLAnchorElement>("#lead-booking-refresh");
  bookingRefresh?.addEventListener("click", (event) => {
    if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
    event.preventDefault();
    history.replaceState(history.state, "", bookingRefresh.href);
    window.location.reload();
  });

  const form = document.querySelector<HTMLFormElement>("#crm-reply-form");
  const templates = {
    project: ["Sobre tu proyecto", "Gracias por contarme sobre tu proyecto. ¿Qué te gustaría conseguir y para cuándo lo necesitas?"],
    job: ["Sobre la oportunidad laboral", "Gracias por pensar en mi perfil. ¿Podrías compartirme las funciones del puesto, la modalidad y los siguientes pasos?"],
    network: ["Gracias por conectar", "Gracias por escribirme. Cuéntame qué tienes en mente y vemos cómo podemos colaborar."],
  } as const;
  const select = document.querySelector<HTMLSelectElement>("#reply-template");
  const confirmationDialog = document.querySelector<HTMLDialogElement>("#crm-reply-confirmation");
  select?.addEventListener("change", async () => {
    const key = select.value as keyof typeof templates;
    const subject = form?.querySelector<HTMLInputElement>('input[name="subject"]');
    const body = form?.querySelector<HTMLTextAreaElement>('textarea[name="body"]');
    if (!subject || !body || !Object.hasOwn(templates, key)) return;
    select.value = "";
    if ((body.value.trim() || subject.value !== subject.defaultValue) &&
      !await confirmCrmAction(confirmationDialog, {
        title: "¿Usar esta plantilla?",
        message: "La plantilla reemplazará el asunto y el mensaje que tenés en el editor.",
        action: "Reemplazar borrador",
      })) return;
    subject.value = templates[key][0];
    const name = select.dataset.firstName;
    body.value = `Hola${name ? " " + name : ""},\n\n${templates[key][1]}\n\nUn saludo,\nOrlando Pineda Raad\nOrPiRa`;
  });

  let confirmedSend = false;
  form?.addEventListener("submit", async (event) => {
    const button = event.submitter;
    if (!(button instanceof HTMLButtonElement) || button.value !== "send" || confirmedSend) return;

    event.preventDefault();
    const recipient = new FormData(form).get("recipient");
    if (!await confirmCrmAction(confirmationDialog, {
      title: "¿Enviar este correo?",
      message: `El mensaje para ${recipient} quedará en cola de envío.`,
      action: "Confirmar envío",
    })) return;

    confirmedSend = true;
    try {
      form.requestSubmit(button);
    } finally {
      confirmedSend = false;
    }
  });
</script>
