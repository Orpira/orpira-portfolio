---
import { stages, stageLabel, stageFeedback } from "../../../lib/crm-pipeline";
import CRMLayout from "../../../layouts/CRMLayout.astro";
import { supabaseAdmin } from "../../../lib/supabase-admin";
import {
  ADMIN_SESSION_COOKIE,
  verifyAdminSession,
} from "../../../lib/admin-session";

if (
  !verifyAdminSession(
    Astro.cookies.get(ADMIN_SESSION_COOKIE)?.value
  )
) {
  return Astro.redirect("/dashboard", 303);
}

const { id } = Astro.params;

const { data: lead } = await supabaseAdmin
  .from("contacts")
  .select("id, name, email, status, lead_type, priority, lead_score, message, created_at")
  .eq("id", id)
  .single();

if (!lead) {
  return Astro.redirect("/dashboard/leads");
}

const [{ data: replies, error: repliesError }, { data: notes, error: notesError }, { data: changes, error: changesError }] = await Promise.all([
  supabaseAdmin.from("commercial_replies")
    .select("id, subject, body, status, created_at, sent_at, smtp_message_id, approved_recipient, manual_requested_at, send_started_at, send_finished_at")
    .eq("contact_id", lead.id).order("created_at", { ascending: false }),
  supabaseAdmin.from("crm_contact_notes")
    .select("id, body, created_at").eq("contact_id", lead.id)
    .order("created_at", { ascending: false }).order("id"),
  supabaseAdmin.from("crm_contact_stage_changes")
    .select("id, from_stage, to_stage, changed_at").eq("contact_id", lead.id)
    .order("changed_at", { ascending: false }).order("id"),
]);

const draft = replies?.find((reply) => reply.status === "draft");
const queued = Boolean(draft?.manual_requested_at);
const showEditor = !repliesError && (!replies?.length || Boolean(draft && !draft.approved_recipient));
const validRecipient = /^[a-z0-9_.+%\-]+@[a-z0-9.-]+\.[a-z]{2,}$/i.test(lead.email) &&
  !/@([a-z0-9-]+\.)*(example\.(com|net|org)|[^@]+\.(test|invalid|localhost))$/i.test(lead.email);

const replyMessages: Record<string, string> = {
  saved: "Borrador guardado.",
  requested: "Correo en cola. n8n revisa los envíos cada cinco minutos.",
  invalid: "Revisá el asunto, el mensaje y el destinatario.",
  conflict: "La respuesta cambió o ya está en cola. Revisá el historial antes de continuar.",
  error: "No se pudo guardar la respuesta.",
};
const feedback = replyMessages[Astro.url.searchParams.get("reply") ?? ""];
const noteMessages: Record<string, string> = {
  saved: "Nota guardada.",
  invalid: "La nota debe tener entre 1 y 4000 caracteres.",
  error: "No se pudo guardar la nota.",
};
const noteFeedback = noteMessages[Astro.url.searchParams.get("nota") ?? ""];
const replyStatuses: Record<string, string> = {
  draft: "Borrador",
  sending: "Envío en curso",
  sent: "Enviado",
  failed: "Envío fallido",
  unknown: "Resultado sin confirmar",
};
const currentStage = stages.findIndex((stage) => stage.id === lead.status);
const stageNotice = stageFeedback[Astro.url.searchParams.get("etapa") ?? ""];
const dateFormat = new Intl.DateTimeFormat("es-ES", {
  dateStyle: "medium",
  timeStyle: "short",
  timeZone: "Europe/Madrid",
});
const formatDate = (date: string) => dateFormat.format(new Date(date));
const fields = [
  { label: "Estado comercial", value: stageLabel(lead.status) },
  { label: "Tipo de consulta", value: lead.lead_type?.replaceAll("_", " ") },
  { label: "Prioridad", value: lead.priority },
  { label: "Puntuación", value: lead.lead_score },
];
---

<CRMLayout title={`${lead.name} | CRM OrPiRa`}>
  <div class="mx-auto max-w-7xl space-y-6 text-slate-900">
    <header class="flex flex-wrap items-end justify-between gap-3">
      <div class="min-w-0">
        <a href="/dashboard/leads" class="text-sm font-semibold text-teal-800 hover:underline">← Volver a Leads</a>
        <h1 class="mt-3 break-words text-3xl font-bold tracking-tight sm:text-4xl">{lead.name}</h1>
        <p class="mt-1 break-all text-slate-600">{lead.email}</p>
      </div>
      <time class="text-sm text-slate-600" datetime={lead.created_at}>Recibido el {formatDate(lead.created_at)}</time>
    </header>

    <section class="space-y-3 rounded-xl border border-slate-200 bg-white p-4" aria-labelledby="stage-title">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 id="stage-title" class="font-semibold"><a href="/dashboard/embudo" class="text-teal-800 hover:underline">Embudo comercial</a></h2>
        <form method="post" action={`/dashboard/lead/${lead.id}/etapa`} class="flex flex-wrap gap-2">
          <input type="hidden" name="from" value={lead.status ?? ""} />
          <input type="hidden" name="return" value="lead" />
          <select name="to" required aria-label="Cambiar etapa" class="rounded-lg border-slate-300 bg-white text-sm">
            <option value="">Mover a…</option>
            {stages.filter((stage) => stage.id !== lead.status).map((stage) => <option value={stage.id}>{stage.label}</option>)}
          </select>
          <button class="rounded-lg bg-teal-700 px-3 text-sm font-semibold text-white hover:bg-teal-800">Cambiar etapa</button>
        </form>
      </div>
      <ol class="grid grid-cols-2 gap-2 text-sm sm:grid-cols-5">
        {stages.map((stage, index) => (
          <li aria-current={index === currentStage ? "step" : undefined}
            class:list={["rounded-lg px-3 py-2", index === currentStage ? "bg-teal-800 font-semibold text-white" : "bg-slate-100 text-slate-700"]}>
            {stage.label}
          </li>
        ))}
      </ol>
      {stageNotice && <p role="status" class="text-sm text-teal-900">{stageNotice}</p>}
    </section>

    <dl class="grid grid-cols-2 gap-3 lg:grid-cols-4">
      {fields.map(({ label, value }) => (
        <div class="rounded-xl border border-slate-200 bg-white p-4">
          <dt class="text-sm text-slate-600">{label}</dt>
          <dd class="mt-1 break-words font-semibold capitalize">{value ?? "Sin asignar"}</dd>
        </div>
      ))}
    </dl>

    <div class="grid gap-6 lg:grid-cols-2">
      <section class="min-w-0 self-start rounded-xl border border-slate-200 bg-white p-5" aria-labelledby="original-title">
        <h2 id="original-title" class="text-lg font-semibold">Mensaje recibido</h2>
        <p class="mt-3 whitespace-pre-wrap break-words text-slate-700">{lead.message}</p>
      </section>

      <section id="respuesta" class="min-w-0 rounded-xl border border-slate-200 bg-white p-5" aria-labelledby="reply-title">
        <h2 id="reply-title" class="text-lg font-semibold">Responder al lead</h2>
        {feedback && <p role="status" class="mt-3 rounded-lg bg-teal-50 p-3 text-sm text-teal-900">{feedback}</p>}
        {showEditor ? (
          <form id="crm-reply-form" method="post" action={`/dashboard/lead/${lead.id}/reply`} class="mt-4 space-y-4">
            {draft && <input type="hidden" name="replyId" value={draft.id} />}
            <input type="hidden" name="recipient" value={lead.email} />
            <p class="break-all text-sm text-slate-600">Para {lead.email}</p>
            <label class="grid gap-1 text-sm font-medium">
              Asunto
              <input name="subject" maxlength="200" required value={draft?.subject ?? "Re: Consulta a OrPiRa"}
                class="w-full rounded-lg border-slate-300 bg-white text-slate-900" />
            </label>
            <label class="grid gap-1 text-sm font-medium">
              Mensaje
              <textarea name="body" maxlength="10000" rows="8" required
                class="w-full rounded-lg border-slate-300 bg-white text-slate-900">{draft?.body ?? ""}</textarea>
            </label>
            <div class="flex flex-wrap gap-3">
              <button name="action" value="save" class="rounded-lg border border-slate-300 px-4 py-2 font-semibold hover:bg-slate-100">
                Guardar borrador
              </button>
              {validRecipient && (
                <button name="action" value="send" class="rounded-lg bg-teal-700 px-4 py-2 font-semibold text-white hover:bg-teal-800">
                  Enviar correo
                </button>
              )}
            </div>
            {!validRecipient && <p class="text-sm text-amber-800">El correo del contacto no admite envío.</p>}
          </form>
        ) : (
          <p class="mt-3 text-sm text-slate-600">
            {repliesError ? "El editor no está disponible en este momento." :
              queued ? "El correo está en cola. Consultá el resultado en la actividad." :
              "Consultá el estado de la respuesta en la actividad del contacto."}
          </p>
        )}
      </section>
    </div>

    <section class="rounded-xl border border-slate-200 bg-white p-5" aria-labelledby="activity-title">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 id="activity-title" class="text-lg font-semibold">Actividad del contacto</h2>
        {(queued || replies?.some((reply) => reply.status === "sending")) && (
          <a href={`/dashboard/lead/${lead.id}#activity-title`} class="text-sm font-semibold text-teal-800 hover:underline">Actualizar estado</a>
        )}
      </div>
      <ol class="mt-4 space-y-4 border-l-2 border-slate-200 pl-4">
        <li>
          <p class="font-medium">Contacto recibido</p>
          <time class="text-sm text-slate-600" datetime={lead.created_at}>{formatDate(lead.created_at)}</time>
        </li>
        {changes?.map((change) => (
          <li>
            <p class="font-medium">{stageLabel(change.from_stage)} → {stageLabel(change.to_stage)}</p>
            <time class="text-sm text-slate-600" datetime={change.changed_at}>{formatDate(change.changed_at)}</time>
          </li>
        ))}
        {replies?.map((reply) => {
          const status = reply.status === "draft" && reply.manual_requested_at ? "En cola" : replyStatuses[reply.status] ?? reply.status;
          const events = [
            { label: "Borrador creado", at: reply.created_at },
            { label: "Envío manual solicitado", at: reply.manual_requested_at },
            { label: "Envío iniciado", at: reply.send_started_at },
            { label: reply.sent_at ? "Aceptado por SMTP" : "Resultado registrado", at: reply.sent_at ?? reply.send_finished_at },
          ];
          return (
            <li class="space-y-3 rounded-lg border border-slate-200 p-4">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <h3 class="break-words font-semibold">{reply.subject}</h3>
                <span class:list={["rounded-full px-2.5 py-1 text-xs font-semibold",
                  reply.status === "sent" ? "bg-emerald-100 text-emerald-900" :
                  ["unknown", "failed"].includes(reply.status) ? "bg-amber-100 text-amber-900" : "bg-slate-100 text-slate-800"]}>{status}</span>
              </div>
              <dl class="space-y-1 text-sm">
                {events.filter(({ at }) => at).map(({ label, at }) => (
                  <div class="flex flex-wrap gap-x-2">
                    <dt class="font-medium">{label}</dt>
                    <dd class="text-slate-600"><time datetime={at}>{formatDate(at)}</time></dd>
                  </div>
                ))}
                {reply.smtp_message_id && (
                  <div><dt class="font-medium">Identificador SMTP</dt><dd class="break-all text-slate-600">{reply.smtp_message_id}</dd></div>
                )}
              </dl>
              <details>
                <summary class="cursor-pointer text-sm font-semibold text-teal-800">Ver respuesta</summary>
                <p class="mt-2 whitespace-pre-wrap break-words text-slate-700">{reply.body}</p>
              </details>
            </li>
          );
        })}
      </ol>
      {changesError && <p class="mt-3 text-sm text-amber-800">No se pudieron cargar los cambios de etapa.</p>}
      {repliesError && <p class="mt-3 text-sm text-amber-800">No se pudo cargar el historial de respuestas.</p>}
    </section>
    <section id="notas" class="rounded-xl border border-slate-200 bg-white p-5" aria-labelledby="notes-title">
      <h2 id="notes-title" class="text-lg font-semibold">Notas internas</h2>
      {noteFeedback && <p role="status" class="mt-3 text-sm text-slate-700">{noteFeedback}</p>}
      {notesError ? (
        <p class="mt-3 text-sm text-amber-800">No se pudieron cargar las notas.</p>
      ) : (
        <>
          <form method="post" action={`/dashboard/lead/${lead.id}/nota`} class="mt-4 space-y-3">
            <label class="grid gap-1 text-sm font-medium">
              Añadir nota de seguimiento
              <textarea name="body" rows="3" maxlength="4000" required
                class="rounded-lg border-slate-300 bg-white text-slate-900" />
            </label>
            <button class="rounded-lg border border-slate-300 px-4 py-2 font-semibold hover:bg-slate-100">
              Guardar nota
            </button>
          </form>
          {!!notes?.length && (
            <ol class="mt-5 divide-y divide-slate-200">
              {notes.map((note) => (
                <li class="py-3">
                  <time class="text-sm text-slate-600" datetime={note.created_at}>{formatDate(note.created_at)}</time>
                  <p class="mt-1 whitespace-pre-wrap break-words">{note.body}</p>
                </li>
              ))}
            </ol>
          )}
        </>
      )}
    </section>

  </div>
</CRMLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("#crm-reply-form");
  form?.addEventListener("submit", (event) => {
    const button = event.submitter;
    if (button instanceof HTMLButtonElement && button.value === "send") {
      const recipient = new FormData(form).get("recipient");
      if (!window.confirm(`¿Poner en cola el correo para ${recipient}?`)) event.preventDefault();
    }
  });
</script>
