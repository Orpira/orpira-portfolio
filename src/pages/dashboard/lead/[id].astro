---
import CRMLayout from "../../../layouts/CRMLayout.astro";
import { supabaseAdmin } from "../../../lib/supabase-admin";
import {
  ADMIN_SESSION_COOKIE,
  verifyAdminSession,
} from "../../../lib/admin-session";

if (
  !verifyAdminSession(
    Astro.cookies.get(ADMIN_SESSION_COOKIE)?.value
  )
) {
  return Astro.redirect("/dashboard", 303);
}

const { id } = Astro.params;

const { data: lead } = await supabaseAdmin
  .from("contacts")
  .select("id, name, email, status, lead_type, priority, lead_score, message")
  .eq("id", id)
  .single();

if (!lead) {
  return Astro.redirect("/dashboard/leads");
}

const { data: replies, error: repliesError } = await supabaseAdmin
  .from("commercial_replies")
  .select("id, subject, body, status, created_at, sent_at, smtp_message_id")
  .eq("contact_id", lead.id)
  .order("created_at", { ascending: false });

const replyStatuses: Record<string, string> = {
  draft: "Borrador",
  sending: "Envío en curso",
  sent: "Enviado",
  failed: "Envío fallido",
  unknown: "Resultado sin confirmar",
};

const dateFormat = new Intl.DateTimeFormat("es-ES", {
  dateStyle: "medium",
  timeStyle: "short",
  timeZone: "Europe/Madrid",
});
---

<CRMLayout title={lead.name}>

<div class="space-y-6">

  <div>

    <h1 class="text-4xl font-bold">
      {lead.name}
    </h1>

    <p class="text-slate-400">
      Detalle del Lead
    </p>

  </div>

  <div
    class="grid md:grid-cols-2 gap-6"
  >

    <div
      class="bg-slate-900 rounded-xl p-6"
    >

      <h2 class="font-bold mb-4">
        Información
      </h2>

      <div class="space-y-3">

        <p>
          <strong>Email:</strong>
          {lead.email}
        </p>

        <p>
          <strong>Estado:</strong>

          <span
            class={
              lead.status === "won"
                ? "text-green-400"
                : lead.status === "lost"
                ? "text-red-400"
                : lead.status === "qualified"
                ? "text-blue-400"
                : "text-yellow-400"
            }
          >
            {lead.status}
          </span>

        </p>

        <p>
          <strong>Tipo:</strong>
          {lead.lead_type}
        </p>

        <p>
          <strong>Prioridad:</strong>
          {lead.priority}
        </p>

        <p>
          <strong>Score:</strong>
          {lead.lead_score}
        </p>

      </div>

    </div>

    <div
      class="bg-slate-900 rounded-xl p-6"
    >

      <h2 class="font-bold mb-4">
        Mensaje
      </h2>

      <p class="text-slate-300">
        {lead.message}
      </p>

    </div>

  </div>

  <section class="bg-slate-900 rounded-xl p-6" aria-labelledby="commercial-replies-title">
    <h2 id="commercial-replies-title" class="font-bold mb-4">Historial de respuestas comerciales</h2>
    {repliesError ? (
      <p class="text-amber-300">El historial no está disponible en este momento.</p>
    ) : !replies?.length ? (
      <p class="text-slate-400">Todavía no hay respuestas registradas para este lead.</p>
    ) : (
      <ul class="space-y-4">
        {replies.map((reply) => (
          <li class="rounded-lg border border-slate-700 p-4">
            <h3 class="font-semibold break-words">{reply.subject}</h3>
            <p class="text-sm text-slate-400">{replyStatuses[reply.status] ?? reply.status}</p>
            <p class="text-sm text-slate-400">
              Creado el <time datetime={reply.created_at}>{dateFormat.format(new Date(reply.created_at))}</time>
            </p>
            {reply.sent_at && (
              <p class="text-sm text-slate-400">
                Enviado el <time datetime={reply.sent_at}>{dateFormat.format(new Date(reply.sent_at))}</time>
              </p>
            )}
            {reply.smtp_message_id && <p class="text-sm text-slate-400 break-all">ID SMTP {reply.smtp_message_id}</p>}
            <p class="mt-3 whitespace-pre-wrap break-words text-slate-300">{reply.body}</p>
          </li>
        ))}
      </ul>
    )}
  </section>
</div>

</CRMLayout>
