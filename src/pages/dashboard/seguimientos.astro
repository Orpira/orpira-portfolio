---
import CRMLayout from "../../layouts/CRMLayout.astro";
import { categories, isContactCategory } from "../../lib/crm-categories";
import { supabaseAdmin } from "../../lib/supabase-admin";

const parts = new Intl.DateTimeFormat("en", {
  timeZone: "Europe/Madrid", year: "numeric", month: "2-digit", day: "2-digit",
}).formatToParts(new Date());
const today = ["year", "month", "day"].map((part) => parts.find(({ type }) => type === part)?.value).join("-");
const followUps = () => supabaseAdmin.from("contacts")
  .select("id,name,contact_category,next_follow_up_on,next_follow_up_action")
  .or("status.is.null,status.not.in.(won,lost)")
  .order("next_follow_up_on").order("id").limit(100);

const [due, upcoming] = await Promise.all([
  followUps().lte("next_follow_up_on", today),
  followUps().gt("next_follow_up_on", today),
]);
const groups = [{ title: "Hoy y vencidos", result: due }, { title: "Próximos", result: upcoming }];
const format = new Intl.DateTimeFormat("es-ES", { dateStyle: "medium", timeZone: "UTC" });
---

<CRMLayout title="Seguimientos | CRM OrPiRa">
  <div class="mx-auto max-w-5xl space-y-6 text-slate-900">
    <header>
      <h1 class="text-3xl font-bold tracking-tight">Seguimientos</h1>
      <p class="mt-2 text-slate-600">Programá la próxima fecha desde la ficha de cada contacto.</p>
    </header>
    {groups.map(({ title, result }) => (
      <section class="rounded-xl border border-slate-200 bg-white p-5">
        <h2 class="text-lg font-semibold">{title}</h2>
        {result.error ? <p class="mt-3 text-amber-800">No se pudieron cargar los seguimientos.</p> :
          !result.data?.length ? <p class="mt-3 text-slate-600">Sin seguimientos en este grupo.</p> :
          <ul class="mt-3 divide-y divide-slate-200">
            {result.data.map((contact) => (
              <li class="flex flex-wrap justify-between gap-2 py-3">
                <div>
                  <a class="font-semibold text-teal-800 hover:underline" href={`/dashboard/lead/${contact.id}#seguimiento`}>{contact.name}</a>
                  {contact.next_follow_up_action && <p class="text-sm text-slate-600">{contact.next_follow_up_action}</p>}
                </div>
                <span class="text-sm text-slate-600">
                  {isContactCategory(contact.contact_category) && `${categories[contact.contact_category]} · `}
                  <time datetime={contact.next_follow_up_on}>{format.format(new Date(contact.next_follow_up_on))}</time>
                </span>
              </li>
            ))}
          </ul>}
      </section>
    ))}
  </div>
</CRMLayout>
