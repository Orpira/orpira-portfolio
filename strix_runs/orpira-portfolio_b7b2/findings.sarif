          "fixes": [
            {
              "artifactChanges": [
                {
                  "artifactLocation": {
                    "uri": "src/lib/admin-session.ts"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 1,
                        "endLine": 40
                      },
                      "insertedContent": {
                        "text": "import { createHmac, randomBytes, timingSafeEqual } from \"node:crypto\";\nimport { supabaseAdmin } from \"./supabase-admin\";\n\nexport const ADMIN_SESSION_COOKIE = \"crm_session\";\nexport const ADMIN_SESSION_MAX_AGE = 60 * 60 * 8;\n\nconst ADMIN_SESSION_TABLE = \"admin_sessions\";\n\nconst getSessionSecret = () => {\n\tconst secret = import.meta.env.ADMIN_SESSION_SECRET;\n\n\tif (!secret || secret.length < 32) {\n\t\tthrow new Error(\"ADMIN_SESSION_SECRET debe tener al menos 32 caracteres\");\n\t}\n\n\treturn secret;\n};\n\nconst sign = (value: string) =>\n\tcreateHmac(\"sha256\", getSessionSecret()).update(value).digest(\"base64url\");\n\nconst parseAdminSession = (token?: string) => {\n\tif (!token) return null;\n\n\tconst parts = token.split(\".\");\n\tif (parts.length !== 3) return null;\n\n\tconst [expiresAt, sessionId, signature] = parts;\n\tif (!/^\\d+$/.test(expiresAt) || !sessionId || !signature) return null;\n\n\tconst expiresAtNumber = Number(expiresAt);\n\tif (expiresAtNumber <= Math.floor(Date.now() / 1000)) return null;\n\n\tconst payload = `${expiresAt}.${sessionId}`;\n\tconst expected = Buffer.from(sign(payload));\n\tconst received = Buffer.from(signature);\n\n\tif (expected.length !== received.length || !timingSafeEqual(expected, received)) {\n\t\treturn null;\n\t}\n\n\treturn {\n\t\texpiresAt: expiresAtNumber,\n\t\tsessionId,\n\t\ttoken: `${payload}.${signature}`,\n\t};\n};\n\nexport const createAdminSession = async () => {\n\tconst expiresAt = Math.floor(Date.now() / 1000) + ADMIN_SESSION_MAX_AGE;\n\tconst sessionId = randomBytes(24).toString(\"base64url\");\n\tconst payload = `${expiresAt}.${sessionId}`;\n\tconst token = `${payload}.${sign(payload)}`;\n\n\tconst { error } = await supabaseAdmin.from(ADMIN_SESSION_TABLE).insert({\n\t\tsession_id: sessionId,\n\t\texpires_at: new Date(expiresAt * 1000).toISOString(),\n\t});\n\n\tif (error) {\n\t\tthrow new Error(\"No se pudo registrar la sesion de administrador\");\n\t}\n\n\treturn token;\n};\n\nexport const verifyAdminSession = (token?: string) =>\n\tparseAdminSession(token) !== null;\n\nexport const isAdminSessionActive = async (token?: string) => {\n\tconst session = parseAdminSession(token);\n\n\tif (!session) return false;\n\n\tconst { data, error } = await supabaseAdmin\n\t\t.from(ADMIN_SESSION_TABLE)\n\t\t.select(\"session_id\")\n\t\t.eq(\"session_id\", session.sessionId)\n\t\t.is(\"revoked_at\", null)\n\t\t.gt(\"expires_at\", new Date().toISOString())\n\t\t.maybeSingle();\n\n\treturn !error && Boolean(data);\n};\n\nexport const revokeAdminSession = async (token?: string) => {\n\tconst session = parseAdminSession(token);\n\n\tif (!session) return;\n\n\tconst { error } = await supabaseAdmin\n\t\t.from(ADMIN_SESSION_TABLE)\n\t\t.update({ revoked_at: new Date().toISOString() })\n\t\t.eq(\"session_id\", session.sessionId)\n\t\t.is(\"revoked_at\", null);\n\n\tif (error) {\n\t\tthrow new Error(\"No se pudo invalidar la sesion de administrador\");\n\t}\n};"
                      }
                    }
                  ]
                },
