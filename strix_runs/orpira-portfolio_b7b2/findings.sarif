        {
          "ruleId": "CWE-613",
          "ruleIndex": 2,
          "level": "note",
          "message": {
            "text": "Logout Does Not Invalidate Existing Dashboard Sessions\n\nThe dashboard logout flow deletes the browser cookie but does not invalidate the underlying administrator session. A previously copied `crm_session` token remains valid after logout and continues to grant access to protected CRM pages until the cookie expires."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/lib/admin-session.ts"
                },
                "region": {
                  "startLine": 1,
                  "endLine": 40,
                  "snippet": {
                    "text": "import { createHmac, randomBytes, timingSafeEqual } from \"node:crypto\";\n\nexport const ADMIN_SESSION_COOKIE = \"crm_session\";\nexport const ADMIN_SESSION_MAX_AGE = 60 * 60 * 8;\n\nconst getSessionSecret = () => {\n\tconst secret = import.meta.env.ADMIN_SESSION_SECRET;\n\n\tif (!secret || secret.length < 32) {\n\t\tthrow new Error(\"ADMIN_SESSION_SECRET debe tener al menos 32 caracteres\");\n\t}\n\n\treturn secret;\n};\n\nconst sign = (value: string) =>\n\tcreateHmac(\"sha256\", getSessionSecret()).update(value).digest(\"base64url\");\n\nexport const createAdminSession = () => {\n\tconst expiresAt = Math.floor(Date.now() / 1000) + ADMIN_SESSION_MAX_AGE;\n\tconst payload = `${expiresAt}.${randomBytes(24).toString(\"base64url\")}`;\n\n\treturn `${payload}.${sign(payload)}`;\n};\n\nexport const verifyAdminSession = (token?: string) => {\n\tif (!token) return false;\n\n\tconst parts = token.split(\".\");\n\tif (parts.length !== 3) return false;\n\n\tconst [expiresAt, nonce, signature] = parts;\n\tif (!/^\\d+$/.test(expiresAt) || !nonce || !signature) return false;\n\tif (Number(expiresAt) <= Math.floor(Date.now() / 1000)) return false;\n\n\tconst expected = Buffer.from(sign(`${expiresAt}.${nonce}`));\n\tconst received = Buffer.from(signature);\n\n\treturn expected.length === received.length && timingSafeEqual(expected, received);\n};"
                  }
                }
              },
              "message": {
                "text": "Add server-side session registration and revocation checks"
              }
            },
