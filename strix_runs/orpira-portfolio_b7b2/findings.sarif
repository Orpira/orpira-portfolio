                },
                "region": {
                  "startLine": 34,
                  "endLine": 53,
                  "snippet": {
                    "text": "export const getClientIp = (request: Request) => {\n\tconst realIp = request.headers.get(\"x-real-ip\")?.trim();\n\tif (realIp) {\n\t\treturn realIp;\n\t}\n\n\tconst forwarded = request.headers.get(\"x-forwarded-for\");\n\tif (forwarded) {\n\t\tconst candidates = forwarded\n\t\t\t.split(\",\")\n\t\t\t.map((value) => value.trim())\n\t\t\t.filter(Boolean);\n\n\t\tif (candidates.length > 0) {\n\t\t\treturn candidates[candidates.length - 1];\n\t\t}\n\t}\n\n\treturn \"unknown\";\n};"
                  }
                }
              },
              "message": {
                "text": "Untrusted header-based IP extraction used in a security decision"
              }
